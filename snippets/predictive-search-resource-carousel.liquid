{%- doc -%}
  Renders predictive Page or Blog search resources.

  @param {object} resources - Resources to display
  @param {string} resource_type - Either 'page' or 'article'
  @param {string} [title] - Optional heading
{%- enddoc -%}

{% if title != blank %}
  <h4 class="predictive-search-results__title">{{ title }}</h4>
{% endif %}

{% if resources.size > 0 %}
  <ul class="predictive-search-results__resource-grid list-unstyled">
    {% for resource in resources limit: 5 %}
      <li
        class="predictive-search-results__card predictive-search-results__card--{{ resource_type }}"
        ref="resultsItems[]"
      >
        {% render 'resource-card',
          resource_type: resource_type,
          resource: resource,
          image_width: 500,
          image_aspect_ratio: '3 / 2',
          variant: 'ogee-search'
        %}
      </li>
    {% endfor %}
  </ul>
{% else %}
  <p class="predictive-search-results__no-results">
    {{ 'content.no_results_found' | t }}
  </p>
{% endif %}
