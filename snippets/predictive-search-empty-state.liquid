{% doc %}
  Renders the Ogee predictive-search empty state.

  @param {number} shadow_opacity - Shadow opacity for the container
  @param {string} products_test_id - Optional test id
  @param {boolean} [load_empty_state] - Whether to render the state

  @example
  {% render 'predictive-search-empty-state', shadow_opacity: 0.1, products_test_id: 'empty-state' %}
{% enddoc %}

<div
  id="predictive-search-results"
  class="predictive-search-dropdown predictive-search-dropdown--ogee"
  role="listbox"
  aria-expanded="true"
  style="--color-shadow: rgb(var(--color-foreground-rgb) / {{ shadow_opacity }});"
>
  {% if load_empty_state %}
    <div class="predictive-search-results__inner predictive-search-results__inner--empty">
      <div class="predictive-search-results__history" data-search-history hidden>
        <p class="predictive-search-results__history-label">{{ 'content.search_results_resource_queries' | t }}</p>
        <ul class="predictive-search-results__keywords" data-search-history-list></ul>
      </div>

      {% if settings.search_trending_menu != blank %}
        <div class="predictive-search-results__history">
          <p class="predictive-search-results__history-label">{{ settings.search_trending_menu.title }}</p>
          <div class="predictive-search-results__keywords">
            {% for link in settings.search_trending_menu.links limit: 6 %}
              <a
                class="predictive-search-results__keyword"
                href="{{ link.url }}"
                data-search-keyword="{{ link.title | escape }}"
              >
                {{ link.title }}
              </a>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% liquid
        assign bestsellers = settings.empty_state_collection | default: collections.all
        assign new_products = settings.search_new_collection | default: collections.all
      %}

      <div class="search-empty-tabs" role="tablist" aria-label="{{ 'content.featured_products' | t }}">
        <button
          class="search-empty-tabs__tab"
          type="button"
          role="tab"
          id="SearchEmptyTab-bestsellers"
          aria-controls="SearchEmptyPanel-bestsellers"
          aria-selected="true"
          data-search-empty-tab="bestsellers"
          on:keydown="/onSearchTabKeyDown"
        >
          {{ bestsellers.title }}
        </button>
        <button
          class="search-empty-tabs__tab"
          type="button"
          role="tab"
          id="SearchEmptyTab-new"
          aria-controls="SearchEmptyPanel-new"
          aria-selected="false"
          tabindex="-1"
          data-search-empty-tab="new"
          on:keydown="/onSearchTabKeyDown"
        >
          {{ new_products.title }}
        </button>
      </div>

      <div
        id="SearchEmptyPanel-bestsellers"
        class="predictive-search-results__panel"
        role="tabpanel"
        aria-labelledby="SearchEmptyTab-bestsellers"
        data-search-empty-panel="bestsellers"
      >
        {% render 'predictive-search-products-list',
          products_test_id: products_test_id,
          products: bestsellers.products,
          limit: 10,
          list_id: 'predictive-search-bestsellers'
        %}
      </div>

      <div
        id="SearchEmptyPanel-new"
        class="predictive-search-results__panel"
        role="tabpanel"
        aria-labelledby="SearchEmptyTab-new"
        data-search-empty-panel="new"
        hidden
      >
        {% render 'predictive-search-products-list',
          products: new_products.products,
          limit: 10,
          list_id: 'predictive-search-new'
        %}
      </div>
    </div>
  {% endif %}
</div>
