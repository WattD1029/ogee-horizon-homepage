{%- doc -%}
  Renders a product grid for predictive-search states.

  @param {object[]} products - Products to display
  @param {string} [title] - Optional heading
  @param {number} [limit] - Maximum number of products
  @param {string} [list_id] - Optional wrapper id
  @param {string[]} [order_ids] - Product ids in display order
  @param {string} [products_test_id] - Optional test id
{%- enddoc -%}

{% liquid
  assign limit = limit | default: 10
  assign list_id = list_id | default: 'predictive-search-products'
%}

<div
  id="{{ list_id }}"
  class="predictive-search-results__products"
  {% if products_test_id %}
    data-testid="{{ products_test_id }}"
  {% endif %}
>
  {% if title != blank %}
    <h4 class="predictive-search-results__title">{{ title }}</h4>
  {% endif %}
  <ul class="predictive-search-results__list predictive-search-results__wrapper-products list-unstyled">
    {% if order_ids != blank %}
      {% for product_id in order_ids limit: limit %}
        {% assign integer_id = product_id | times: 1 %}
        {% assign product = products | find: 'id', integer_id %}
        {% if product != blank %}
          <li class="predictive-search-results__card predictive-search-results__card--product" ref="resultsItems[]">
            {% render 'resource-card',
              resource_type: 'product',
              resource: product,
              image_width: 500,
              image_hover: true,
              image_aspect_ratio: '1 / 1',
              variant: 'ogee-search'
            %}
          </li>
        {% endif %}
      {% endfor %}
    {% else %}
      {% for product in products limit: limit %}
        <li class="predictive-search-results__card predictive-search-results__card--product" ref="resultsItems[]">
          {% render 'resource-card',
            resource_type: 'product',
            resource: product,
            image_width: 500,
            image_hover: true,
            image_aspect_ratio: '1 / 1',
            variant: 'ogee-search'
          %}
        </li>
      {% endfor %}
    {% endif %}
  </ul>
</div>
