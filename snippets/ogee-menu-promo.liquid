{% doc %}
  Renders an editable promotion, optionally with a second manually advanced slide.
  @param {object} settings - Header menu settings
  @param {string} key - Panel key
  @param {string} [fallback_asset] - Exact Figma artwork stored in theme assets
  @param {string} [fallback_url] - Collection URL when no promotion URL is selected
{% enddoc %}
{% liquid
  assign image_id = key | append: '_promo_image'
  assign second_id = key | append: '_promo_second_image'
  assign slide_count = 1
  if settings[second_id] != blank
    assign slide_count = 2
  endif
%}
<ogee-menu-promo class="ogee-menu-promo" role="region" aria-roledescription="carousel">
  {% for slide in (1..slide_count) %}
    {% liquid
      assign prefix = key | append: '_promo_'
      if slide == 2
        assign prefix = key | append: '_promo_second_'
      endif
      assign image_id = prefix | append: 'image'
      assign heading_id = prefix | append: 'heading'
      assign url_id = prefix | append: 'url'
      assign promo_url = settings[url_id] | default: fallback_url
    %}
    <div class="ogee-menu-promo__slide" data-promo-slide {% if slide != 1 %}hidden{% endif %} role="group" aria-label="{{ 'ogee_menu.promotion' | t: index: slide, total: slide_count }}">
      {% if promo_url != blank %}<a href="{{ promo_url }}" class="ogee-menu-promo__link">{% endif %}
      {% if settings[image_id] != blank %}
        {{ settings[image_id] | image_url: width: 750 | image_tag: widths: '250,500,750', sizes: '250px', loading: 'lazy', class: 'ogee-menu-promo__image' }}
      {% elsif fallback_asset != blank %}
        <img src="{{ fallback_asset | asset_url }}" alt="" width="250" height="350" loading="lazy" class="ogee-menu-promo__image">
      {% endif %}
      {% if settings[heading_id] != blank %}<span class="ogee-menu-promo__copy">{{ settings[heading_id] | escape }}</span>{% endif %}
      {% if promo_url != blank %}<span class="ogee-menu-promo__cta">{{ 'ogee_menu.shop_all' | t }}</span></a>{% endif %}
    </div>
  {% endfor %}
  {% if slide_count > 1 %}
    <div class="ogee-menu-promo__controls">
      <button type="button" data-promo-step="-1" aria-label="{{ 'ogee_menu.previous' | t }}"><span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span></button>
      <span aria-live="polite" data-promo-status>1 / {{ slide_count }}</span>
      <button type="button" data-promo-step="1" aria-label="{{ 'ogee_menu.next' | t }}"><span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span></button>
    </div>
  {% endif %}
</ogee-menu-promo>
{% javascript %}
  if (!customElements.get('ogee-menu-promo')) {
    customElements.define('ogee-menu-promo', class extends HTMLElement {
      connectedCallback() { this.addEventListener('click', this.advance); }
      disconnectedCallback() { this.removeEventListener('click', this.advance); }
      advance = (event) => {
        const button = event.target.closest('[data-promo-step]');
        if (!button) return;
        const slides = [...this.querySelectorAll('[data-promo-slide]')];
        const current = slides.findIndex(slide => !slide.hidden);
        const next = (current + Number(button.dataset.promoStep) + slides.length) % slides.length;
        slides.forEach((slide, index) => { slide.hidden = index !== next; });
        this.querySelector('[data-promo-status]').textContent = `${next + 1} / ${slides.length}`;
      };
    });
  }
{% endjavascript %}
{% stylesheet %}
  .ogee-menu-promo { display:block; position:relative; width:250px; min-width:0; }
  .ogee-menu-promo__slide { position:relative; }
  .ogee-menu-promo__slide[hidden] { display:none; }
  .ogee-menu-promo__link { display:block; color:#333; }
  .ogee-menu-promo__image { display:block; width:100%; height:350px; object-fit:cover; }
  .ogee-menu-promo__copy,.ogee-menu-promo__cta { position:absolute; left:16px; right:16px; bottom:44px; font-size:14px; line-height:21px; }
  .ogee-menu-promo__cta { bottom:16px; text-decoration:underline; }
  .ogee-menu-promo__controls { display:flex; justify-content:space-between; align-items:center; height:44px; font-size:12px; }
  .ogee-menu-promo__controls button { border:0; background:transparent; width:44px; height:44px; cursor:pointer; }
  .ogee-menu-promo__controls button:first-child .svg-wrapper { rotate:180deg; }
{% endstylesheet %}
