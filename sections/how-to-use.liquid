{% liquid
  assign media_type = section.settings.media_type | default: 'image'
  assign media_image = section.settings.image
  assign media_video = section.settings.video
  assign image_alt = section.settings.image_alt
  assign video_label = section.settings.video_label
  assign fallback_image_asset = section.settings.fallback_image_asset | default: 'how-to-use-poster.jpg'
  assign fallback_image_width = 1800
  assign fallback_image_height = 1247
  assign loading = 'lazy'
  assign fetch_priority = 'auto'
  assign show_video = false

  if image_alt == blank
    assign image_alt = media_image.alt
  endif

  if video_label == blank
    assign video_label = media_video.alt
  endif

  if media_type == 'video'
    if media_video != blank
      assign show_video = true
    endif
  endif

  if section.index <= 3
    assign loading = 'eager'
  endif

  if section.index == 1
    assign fetch_priority = 'high'
  endif
%}

<section
  id="HowToUse-{{ section.id }}"
  class="how-to-use-section color-{{ section.settings.color_scheme }}"
  data-testid="how-to-use-section"
  style="
    --how-to-use-background: {{ section.settings.background_color }};
    --how-to-use-heading-color: {{ section.settings.heading_color }};
    --how-to-use-text-color: {{ section.settings.text_color }};
    --how-to-use-content-width: {{ section.settings.content_width }}px;
    --how-to-use-mobile-media-height: {{ section.settings.mobile_media_height }}px;
  "
>
  <div class="how-to-use-section__inner">
    <div class="how-to-use-section__media">
      {% if show_video %}
        {{
          media_video
          | video_tag:
            image_size: '1800x',
            controls: true,
            loop: section.settings.video_loop,
            playsinline: true,
            preload: 'metadata',
            loading: loading,
            class: 'how-to-use-section__video',
            aria-label: video_label
        }}
      {% elsif media_image != blank %}
        {{
          media_image
          | image_url: width: 1800
          | image_tag:
            widths: '350, 525, 700, 900, 1200, 1600, 1800',
            sizes: '(min-width: 990px) 600px, calc(100vw - 40px)',
            loading: loading,
            fetchpriority: fetch_priority,
            alt: image_alt,
            class: 'how-to-use-section__image'
        }}
      {% elsif fallback_image_asset != blank %}
        <img
          src="{{ fallback_image_asset | asset_url }}"
          width="{{ fallback_image_width }}"
          height="{{ fallback_image_height }}"
          loading="{{ loading }}"
          fetchpriority="{{ fetch_priority }}"
          alt="{{ image_alt | escape }}"
          class="how-to-use-section__image"
        >
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'how-to-use-section__image placeholder-svg' }}
      {% endif %}

      {% if section.settings.show_play_icon and show_video == false %}
        {% if section.settings.video_link != blank %}
          <a
            href="{{ section.settings.video_link }}"
            class="how-to-use-section__play"
            aria-label="{{ section.settings.play_label | escape }}"
          >
            {{ 'how-to-use-play.svg' | inline_asset_content }}
          </a>
        {% else %}
          <span class="how-to-use-section__play" aria-hidden="true">
            {{ 'how-to-use-play.svg' | inline_asset_content }}
          </span>
        {% endif %}
      {% endif %}
    </div>

    <div class="how-to-use-section__content">
      <div class="how-to-use-section__copy">
        {% if section.settings.heading != blank %}
          <h2 class="how-to-use-section__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="how-to-use-section__text rte">
            {{ section.settings.text }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .how-to-use-section {
    padding: 64px var(--page-margin);
    background: var(--how-to-use-background);
    color: var(--how-to-use-text-color);
  }

  .how-to-use-section__inner {
    display: flex;
    align-items: stretch;
    justify-content: center;
    width: 100%;
    max-width: var(--how-to-use-content-width);
    margin-inline: auto;
    background: var(--how-to-use-background);
  }

  .how-to-use-section__media,
  .how-to-use-section__content {
    flex: 1 1 0;
    min-width: 0;
  }

  .how-to-use-section__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .how-to-use-section__image,
  .how-to-use-section__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .how-to-use-section__video {
    background: #000000;
  }

  .how-to-use-section__play {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    color: #fafafa;
    text-decoration: none;
    transform: translate(-50%, -50%);
  }

  .how-to-use-section__play svg {
    display: block;
    width: 42px;
    height: 37px;
    transform: rotate(90deg);
  }

  .how-to-use-section__play:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 6px;
  }

  .how-to-use-section__content {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
  }

  .how-to-use-section__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .how-to-use-section__heading {
    width: 100%;
    margin: 0;
    color: var(--how-to-use-heading-color);
    font-family: "Chronicle Display", Georgia, "Times New Roman", var(--font-heading--family), serif;
    font-size: 32px;
    font-style: normal;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: 0;
    text-transform: capitalize;
  }

  .how-to-use-section__text {
    width: 100%;
    max-width: 400px;
    color: var(--how-to-use-text-color);
    font-family: "Helvetica Neue", Helvetica, Arial, var(--font-body--family), sans-serif;
    font-size: 16px;
    font-style: normal;
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: 0;
  }

  .how-to-use-section__text p {
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .how-to-use-section {
      padding: 32px 20px;
    }

    .how-to-use-section__inner {
      display: flex;
      flex-direction: column;
      gap: 16px;
      max-width: 700px;
    }

    .how-to-use-section__content,
    .how-to-use-section__copy {
      display: contents;
    }

    .how-to-use-section__heading {
      order: 1;
      font-size: 20px;
      line-height: 1.5;
      text-align: center;
    }

    .how-to-use-section__media {
      order: 2;
      width: 100%;
      max-width: 600px;
      margin-inline: auto;
      aspect-ratio: 1 / 1;
      flex: 0 0 auto;
    }

    .how-to-use-section__text {
      order: 3;
      max-width: 400px;
      margin-inline: auto;
      text-align: center;
    }
  }

  @media screen and (max-width: 749px) {
    .how-to-use-section__media {
      max-width: none;
      height: var(--how-to-use-mobile-media-height);
      aspect-ratio: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "How to use",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "text",
      "id": "fallback_image_asset",
      "label": "Fallback theme asset",
      "default": "how-to-use-poster.jpg",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Model applying an Ogee lip product",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "Loop video",
      "default": false,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "text",
      "id": "video_label",
      "label": "Video accessible label",
      "default": "How to use video",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "show_play_icon",
      "label": "Show play icon",
      "default": true,
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "url",
      "id": "video_link",
      "label": "Video link",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "text",
      "id": "play_label",
      "label": "Play link label",
      "default": "Play how to use video",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to use"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 960,
      "max": 1440,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "mobile_media_height",
      "label": "Mobile media height",
      "min": 280,
      "max": 520,
      "step": 10,
      "unit": "px",
      "default": 350
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FAF8F3"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#21272A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "How to use",
      "category": "Product"
    }
  ]
}
{% endschema %}
