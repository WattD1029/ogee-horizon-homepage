    {
      "type": "checkbox",
      "id": "clp_promotion_show_heading_mobile",
      "label": "Show heading on mobile",
      "default": true
    },
    {
      "type": "text",
      "id": "clp_promotion_accordion_label",
      "label": "Accordion accessible label",
      "default": "Promotion details"
    },
    {
      "type": "image_picker",
      "id": "clp_promotion_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "clp_promotion_image_alt",
