<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'recently-viewed-section.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% liquid
  assign pagination_style = 'paginated'
  if section.settings.enable_infinite_scroll
    assign pagination_style = section.settings.pagination_style | default: 'automatic'
  endif

  assign enable_auto_pagination = false
  if pagination_style == 'automatic'
    assign enable_auto_pagination = true
  endif

  assign products_per_page = 24
  if pagination_style != 'automatic'
    assign products_per_page = section.settings.products_per_page
  endif
%}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<results-list
  class="section product-grid-container color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{{ enable_auto_pagination }}"
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  <div
    class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
  >
    {% content_for 'block',
      type: 'filters',
      id: 'filters',
      results: collection,
      results_size: collection.products_count
    %}

    {% paginate collection.products by products_per_page %}
      {% capture children %}
        {% for product in collection.products %}
          <li
            id="{{ section.id }}-{{ product.id }}"
            class="product-grid__item product-grid__item--{{ forloop.index0 }}"
            data-page="{{ paginate.current_page }}"
            data-product-id="{{ product.id }}"
            ref="cards[]"
          >
            {% # theme-check-disable %}
            {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
            {% # theme-check-enable %}
          </li>
        {% endfor %}
      {% endcapture %}

      {% render 'product-grid',
        section: section,
        children: children,
        products: collection.products,
        paginate: paginate,
        enable_infinite_scroll: enable_auto_pagination,
        pagination_style: pagination_style,
        total_products: collection.products_count
      %}
    {% endpaginate %}
  </div>
</results-list>

{% if section.settings.show_recently_viewed_products %}
  {% liquid
    assign recently_viewed_heading = section.settings.recently_viewed_heading
    if recently_viewed_heading == blank
      assign recently_viewed_heading = 'content.recently_viewed_products' | t
    endif

    assign recently_viewed_max_products = section.settings.recently_viewed_max_products | default: 4

    assign recently_viewed_rendered_count = 0
    assign recently_viewed_products = collections.all.products
    assign add_to_cart_label = 'actions.add_to_cart' | t
    assign choose_options_label = 'actions.select_shade' | t
    assign quick_view_label = 'accessibility.product_details' | t

    capture recently_viewed_slides
      if recently_viewed_products != blank
        for recently_viewed_product in recently_viewed_products limit: recently_viewed_max_products
          assign recently_viewed_rendered_count = recently_viewed_rendered_count | plus: 1
          assign slide_index = recently_viewed_rendered_count | minus: 1
          capture slide_children
            render 'product-carousel-card', product: recently_viewed_product, section_id: section.id, card_id: 'recently-viewed-main-' | append: recently_viewed_product.id, badge_label: 'Best-Seller', show_badge: true, badge_limit: 2, card_index: recently_viewed_rendered_count, subtitle_source: 'metafield', show_vendor: false, show_reviews: true, show_swatches: true, show_wishlist: true, fallback_rating: 5, fallback_rating_count: 1, add_to_cart_label: add_to_cart_label, choose_options_label: choose_options_label, quick_view_label: quick_view_label, transition_to_main_product: false, loading: 'lazy'
          endcapture
          render 'slideshow-slide', slide_id: recently_viewed_product.id, index: slide_index, class: 'recently-viewed-products__slide', children: slide_children
        endfor
      endif
    endcapture

    capture recently_viewed_controls
      render 'slideshow-controls', style: 'counter', item_count: recently_viewed_rendered_count, show_arrows: true, arrows_on_media: false, controls_on_media: false, pagination_position: 'right', icon_style: 'arrow', shape: 'square', class: 'recently-viewed-products__controls'
    endcapture
  %}

  <recently-viewed-products
    class="recently-viewed-products color-{{ section.settings.color_scheme }}"
    data-recently-viewed-section
    data-render-section-id="recently-viewed-products"
    data-fallback-section-id="recently-viewed-products"
    data-max-products="{{ recently_viewed_max_products }}"
    data-product-count="{{ recently_viewed_rendered_count }}"
    {% if recently_viewed_rendered_count == 0 %}
      hidden
    {% endif %}
    style="
      --recently-viewed-padding-top: {{ section.settings.recently_viewed_padding_top }}px;
      --recently-viewed-padding-bottom: {{ section.settings.recently_viewed_padding_bottom }}px;
      --recently-viewed-padding-top-mobile: {{ section.settings.recently_viewed_padding_top_mobile }}px;
      --recently-viewed-padding-bottom-mobile: {{ section.settings.recently_viewed_padding_bottom_mobile }}px;
      --recently-viewed-content-width: 1200px;
      --recently-viewed-desktop-gutter: 0px;
      --recently-viewed-mobile-gutter: 16px;
      --recently-viewed-card-gap: 8px;
      --recently-viewed-card-gap-mobile: 16px;
      --recently-viewed-products-desktop: 3;
      --recently-viewed-card-width-mobile: {{ section.settings.recently_viewed_mobile_card_width }}px;
      --recently-viewed-media-background: #f1f1ef;
    "
  >
    <div class="recently-viewed-products__asset-primer" hidden aria-hidden="true">
      {% render 'product-carousel-card',
        product: blank,
        section_id: section.id,
        card_id: 'recently-viewed-main-asset-primer',
        show_reviews: false,
        show_swatches: false,
        show_wishlist: false
      %}
    </div>

    <div class="recently-viewed-products__inner">
      <h2 class="recently-viewed-products__heading">{{ recently_viewed_heading | escape }}</h2>
      <div
        class="visually-hidden"
        data-recently-viewed-status
        role="status"
        aria-live="polite"
      ></div>
      <div
        class="recently-viewed-products__viewport"
        data-recently-viewed-viewport
      >
        {% if recently_viewed_rendered_count > 0 %}
          {% render 'slideshow',
            class: 'recently-viewed-products__slideshow',
            controls: recently_viewed_controls,
            slides: recently_viewed_slides,
            slide_count: recently_viewed_rendered_count,
            show_arrows: true,
            icon_style: 'arrow',
            icon_shape: 'square',
            arrows_position: 'center',
            autoplay: false,
            infinite: false
          %}
        {% endif %}
      </div>
    </div>
  </recently-viewed-products>
{% endif %}

{% stylesheet %}
  .recently-viewed-products {
    display: block;
    padding-block: var(--recently-viewed-padding-top) var(--recently-viewed-padding-bottom);
    background: rgb(var(--color-background-rgb));
    color: rgb(var(--color-foreground-rgb));
  }

  .recently-viewed-products[hidden] {
    display: none;
  }

  .recently-viewed-products__asset-primer {
    display: none;
  }

  .recently-viewed-products__inner {
    width: min(100%, var(--recently-viewed-content-width));
    margin-inline: auto;
    padding-inline: var(--recently-viewed-desktop-gutter);
  }

  .recently-viewed-products__heading {
    margin: 0 0 24px;
    color: inherit;
    font-family: "Times New Roman", Times, serif;
    font-size: 32px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.1;
    text-align: center;
    text-transform: capitalize;
  }

  .recently-viewed-products__slideshow {
    --recently-viewed-slide-width: calc(
      (100% - (var(--recently-viewed-card-gap) * (var(--recently-viewed-products-desktop) - 1))) /
        var(--recently-viewed-products-desktop)
    );
    display: block;
  }

  .recently-viewed-products__slideshow slideshow-container {
    position: relative;
  }

  .recently-viewed-products__slideshow slideshow-slides {
    align-items: flex-start;
    gap: var(--recently-viewed-card-gap);
    justify-content: center;
    scrollbar-width: none;
  }

  .recently-viewed-products__slideshow slideshow-slides::-webkit-scrollbar {
    display: none;
  }

  .recently-viewed-products__slide {
    display: flex;
    flex: 0 0 var(--recently-viewed-slide-width);
    scroll-snap-align: start;
  }

  .recently-viewed-products__slide > product-card {
    width: 100%;
  }

  .recently-viewed-products__controls {
    display: none;
  }

  .recently-viewed-products__slideshow slideshow-arrows {
    inset: 0 0 auto;
    height: var(--recently-viewed-slide-width);
    mix-blend-mode: normal;
    padding-inline: 8px;
  }

  .recently-viewed-products__slideshow slideshow-arrows .slideshow-control {
    min-width: 40px;
    min-height: 40px;
    width: 40px;
    height: 40px;
    padding: 0;
    opacity: 1;
    color: rgb(var(--color-foreground-rgb));
    background: rgb(var(--color-background-rgb) / 0.72);
    border: 0;
  }

  .recently-viewed-products .product-carousel-card {
    gap: 16px;
    color: inherit;
  }

  .recently-viewed-products .product-carousel-card__media {
    background: var(--recently-viewed-media-background);
  }

  .recently-viewed-products .product-carousel-card__media slideshow-container,
  .recently-viewed-products .product-carousel-card__media slideshow-slides,
  .recently-viewed-products .product-carousel-card__media slideshow-slide,
  .recently-viewed-products .product-carousel-card__media .product-media,
  .recently-viewed-products .product-carousel-card__media .product-media-container {
    background: var(--recently-viewed-media-background);
  }

  .recently-viewed-products .product-carousel-card__details {
    gap: 10px;
    padding-inline: 0;
  }

  .recently-viewed-products .product-carousel-card__title {
    color: inherit;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
  }

  .recently-viewed-products .product-carousel-card__subtitle {
    min-height: auto;
    color: rgb(var(--color-foreground-rgb) / 0.68);
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0.6px;
    line-height: 1.5;
  }

  .recently-viewed-products .product-carousel-card__price {
    color: inherit;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
  }

  .recently-viewed-products .product-rating {
    gap: 0;
    min-height: 15px;
  }

  .recently-viewed-products .product-rating__stars {
    gap: 2px;
  }

  .recently-viewed-products .product-rating__star {
    width: 10px;
    height: 10px;
    color: rgb(var(--color-foreground-rgb));
  }

  .recently-viewed-products .product-rating__count,
  .recently-viewed-products .product-carousel-card__swatch-label {
    display: none;
  }

  .recently-viewed-products .product-carousel-card__swatches {
    margin-top: 0;
  }

  .recently-viewed-products .product-carousel-card__shade-list {
    gap: 4px;
  }

  .recently-viewed-products .product-carousel-card__shade-option {
    width: 22px;
    height: 22px;
  }

  .recently-viewed-products .product-carousel-card__shade-option .swatch {
    width: 14px;
    height: 14px;
  }

  @media screen and (max-width: 989px) {
    .recently-viewed-products__slideshow {
      --recently-viewed-products-desktop: 3;
    }
  }

  @media screen and (max-width: 749px) {
    .recently-viewed-products {
      padding-block: var(--recently-viewed-padding-top-mobile) var(--recently-viewed-padding-bottom-mobile);
    }

    .recently-viewed-products__inner {
      width: 100%;
      padding-inline: var(--recently-viewed-mobile-gutter);
    }

    .recently-viewed-products__heading {
      margin-bottom: 24px;
      font-size: 24px;
    }

    .recently-viewed-products__slideshow {
      --recently-viewed-slide-width: min(
        var(--recently-viewed-card-width-mobile),
        calc(100vw - ((var(--recently-viewed-mobile-gutter) * 2) + 42px))
      );
    }

    .recently-viewed-products__slideshow slideshow-slides {
      gap: var(--recently-viewed-card-gap-mobile);
      justify-content: flex-start;
      margin-inline: calc(var(--recently-viewed-mobile-gutter) * -1);
      padding-inline: var(--recently-viewed-mobile-gutter);
      scroll-padding-inline: var(--recently-viewed-mobile-gutter);
    }

    .recently-viewed-products__slide {
      flex-basis: var(--recently-viewed-slide-width);
    }

    .recently-viewed-products__slideshow slideshow-arrows {
      display: none;
    }

    .recently-viewed-products .product-carousel-card {
      gap: 12px;
    }

    .recently-viewed-products .product-carousel-card__details {
      gap: 8px;
    }

    .recently-viewed-products .product-carousel-card__title {
      font-size: 14px;
      line-height: 1.35;
    }

    .recently-viewed-products .product-carousel-card__subtitle {
      font-size: 10px;
      letter-spacing: 0.5px;
      line-height: 1.5;
    }

    .recently-viewed-products .product-carousel-card__price {
      font-size: 14px;
    }

    .recently-viewed-products .product-carousel-card__swatches {
      display: flex;
    }

    .recently-viewed-products .product-carousel-card__button {
      min-height: 45px;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 1.1px;
      line-height: 1.1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "t:settings.pagination_style",
      "options": [
        {
          "value": "automatic",
          "label": "t:options.auto_load"
        },
        {
          "value": "manual",
          "label": "t:options.load_more"
        }
      ],
      "default": "automatic",
      "visible_if": "{{ section.settings.enable_infinite_scroll == true }}"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Recently viewed products"
    },
    {
      "type": "checkbox",
      "id": "show_recently_viewed_products",
      "label": "Show recently viewed products",
      "default": true
    },
    {
      "type": "text",
      "id": "recently_viewed_heading",
      "label": "Recently viewed heading",
      "default": "Recently Viewed"
    },
    {
      "type": "range",
      "id": "recently_viewed_max_products",
      "label": "Maximum recently viewed products",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "recently_viewed_mobile_card_width",
      "label": "Recently viewed mobile card width",
      "min": 240,
      "max": 340,
      "step": 5,
      "unit": "px",
      "default": 300
    },
    {
      "type": "range",
      "id": "recently_viewed_padding_top",
      "label": "Recently viewed top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "recently_viewed_padding_bottom",
      "label": "Recently viewed bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "recently_viewed_padding_top_mobile",
      "label": "Recently viewed top padding on mobile",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "recently_viewed_padding_bottom_mobile",
      "label": "Recently viewed bottom padding on mobile",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": []
}
{% endschema %}
