{% liquid
  assign heading_text = section.settings.heading_override

  if heading_text == blank
    if collection != blank
      assign heading_text = collection.title
    endif
  endif

  if heading_text == blank
    assign heading_text = 'placeholders.collection_title' | t
  endif

  assign description_text = ''
  assign description_is_plain = false
  assign can_use_description_fallback = false

  if section.settings.description_override != blank
    assign description_text = section.settings.description_override
    assign description_is_plain = true
  elsif collection != blank
    if collection.description != blank
      assign description_text = collection.description
    endif
  endif

  if section.settings.description_fallback != blank
    if section.settings.description_fallback_collection_handle == blank
      assign can_use_description_fallback = true
    elsif collection != blank
      if collection.handle == section.settings.description_fallback_collection_handle
        assign can_use_description_fallback = true
      endif
    endif
  endif

  if description_text == blank
    if can_use_description_fallback
      assign description_text = section.settings.description_fallback
      assign description_is_plain = true
    endif
  endif
%}

<section
  class="clp-intro color-{{ section.settings.color_scheme }}"
  style="
    --clp-intro-content-width: {{ section.settings.desktop_content_width }}px;
    --clp-intro-desktop-gutter: {{ section.settings.desktop_gutter }}px;
    --clp-intro-mobile-gutter: {{ section.settings.mobile_gutter }}px;
    --clp-intro-padding-top: {{ section.settings.padding_top }}px;
    --clp-intro-padding-bottom: {{ section.settings.padding_bottom }}px;
    --clp-intro-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --clp-intro-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --clp-intro-navigation-margin-top: {{ section.settings.navigation_margin_top }}px;
    --clp-intro-navigation-margin-top-mobile: {{ section.settings.navigation_margin_top_mobile }}px;
    --clp-intro-navigation-text: {{ section.settings.navigation_text_color }};
    --clp-intro-navigation-border: {{ section.settings.navigation_border_color }};
    --clp-intro-navigation-active-border: {{ section.settings.navigation_active_border_color }};
  "
>
  <div class="clp-intro__inner">
    {% if heading_text != blank %}
      <h1 class="clp-intro__heading">{{ heading_text | escape }}</h1>
    {% endif %}

    {% if description_text != blank %}
      <div class="clp-intro__description">
        {% if description_is_plain %}
          {{ description_text | escape | newline_to_br }}
        {% else %}
          {{ description_text }}
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.show_navigation %}
      <clp-subcollection-navigation class="clp-intro__subcollection-navigation">
        <nav
          class="clp-intro__subcollection-nav"
          aria-label="{{ section.settings.navigation_aria_label | escape }}"
        >
          <ul
            class="clp-intro__subcollection-list"
            data-clp-subcollection-list
          >
            {% if section.blocks.size > 0 %}
              {% for block in section.blocks %}
                {% liquid
                  assign target_collection = block.settings.collection
                  assign link_label = block.settings.label

                  if link_label == blank
                    if target_collection != blank
                      assign link_label = target_collection.title
                    endif
                  endif

                  assign mobile_label = block.settings.mobile_label

                  if mobile_label == blank
                    assign mobile_label = link_label
                  endif

                  assign link_url = block.settings.link

                  if link_url == blank
                    if target_collection != blank
                      assign link_url = target_collection.url
                    endif
                  endif

                  assign is_current = false

                  if collection != blank
                    if target_collection != blank
                      if target_collection.id == collection.id
                        assign is_current = true
                      elsif target_collection.handle == collection.handle
                        assign is_current = true
                      endif
                    endif
                  endif

                  assign navigation_image = blank

                  unless forloop.first
                    if target_collection != blank
                      if target_collection.image != blank
                        assign navigation_image = target_collection.image
                      endif
                    endif
                  endunless
                %}

                {% if link_label != blank %}
                  <li
                    class="clp-intro__subcollection-item"
                    {{ block.shopify_attributes }}
                  >
                    {% if link_url != blank %}
                      <a
                        class="clp-intro__subcollection-link{% if navigation_image != blank %} clp-intro__subcollection-link--has-image{% endif %}"
                        href="{{ link_url }}"
                        {% if is_current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {% if navigation_image != blank %}
                          <span
                            class="clp-intro__subcollection-image"
                            aria-hidden="true"
                          >
                            {{ navigation_image | image_url: width: 100, height: 100 | image_tag: loading: 'lazy', alt: '' }}
                          </span>
                        {% endif %}

                        <span class="clp-intro__subcollection-label clp-intro__subcollection-label--desktop">
                          {{- link_label | escape -}}
                        </span>
                        <span class="clp-intro__subcollection-label clp-intro__subcollection-label--mobile">
                          {{- mobile_label | escape -}}
                        </span>
                      </a>
                    {% else %}
                      <span
                        class="clp-intro__subcollection-link{% if navigation_image != blank %} clp-intro__subcollection-link--has-image{% endif %}"
                        aria-disabled="true"
                      >
                        {% if navigation_image != blank %}
                          <span
                            class="clp-intro__subcollection-image"
                            aria-hidden="true"
                          >
                            {{ navigation_image | image_url: width: 100, height: 100 | image_tag: loading: 'lazy', alt: '' }}
                          </span>
                        {% endif %}

                        <span class="clp-intro__subcollection-label clp-intro__subcollection-label--desktop">
                          {{- link_label | escape -}}
                        </span>
                        <span class="clp-intro__subcollection-label clp-intro__subcollection-label--mobile">
                          {{- mobile_label | escape -}}
                        </span>
                      </span>
                    {% endif %}
                  </li>
                {% endif %}
              {% endfor %}
            {% else %}
              {% for fallback_index in (1..7) %}
                {% liquid
                  case fallback_index
                    when 1
                      assign link_label = 'All'
                      assign mobile_label = 'All Products'
                      assign fallback_collection_handle = 'all'
                    when 2
                      assign link_label = 'Bestseller'
                      assign mobile_label = 'Bestsellers'
                      assign fallback_collection_handle = 'bestsellers'
                    when 3
                      assign link_label = 'New'
                      assign mobile_label = 'New'
                      assign fallback_collection_handle = 'new'
                    when 4
                      assign link_label = 'Makeup'
                      assign mobile_label = 'Makeup'
                      assign fallback_collection_handle = 'makeup'
                    when 5
                      assign link_label = 'Skincare'
                      assign mobile_label = 'Skincare'
                      assign fallback_collection_handle = 'skincare'
                    when 6
                      assign link_label = 'Bundles'
                      assign mobile_label = 'Bundles'
                      assign fallback_collection_handle = 'bundles'
                    when 7
                      assign link_label = 'Accessories'
                      assign mobile_label = 'Accessories'
                      assign fallback_collection_handle = 'accessories'
                  endcase

                  assign target_collection = collections[fallback_collection_handle]
                  assign link_url = ''

                  if target_collection != blank
                    assign link_url = target_collection.url
                  endif

                  assign is_current = false

                  if collection != blank
                    if target_collection != blank
                      if target_collection.id == collection.id
                        assign is_current = true
                      elsif target_collection.handle == collection.handle
                        assign is_current = true
                      endif
                    endif
                  endif

                  assign navigation_image = blank

                  if fallback_index != 1
                    if target_collection != blank
                      if target_collection.image != blank
                        assign navigation_image = target_collection.image
                      endif
                    endif
                  endif
                %}

                <li class="clp-intro__subcollection-item">
                  {% if link_url != blank %}
                    <a
                      class="clp-intro__subcollection-link{% if navigation_image != blank %} clp-intro__subcollection-link--has-image{% endif %}"
                      href="{{ link_url }}"
                      {% if is_current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {% if navigation_image != blank %}
                        <span
                          class="clp-intro__subcollection-image"
                          aria-hidden="true"
                        >
                          {{ navigation_image | image_url: width: 100, height: 100 | image_tag: loading: 'lazy', alt: '' }}
                        </span>
                      {% endif %}

                      <span class="clp-intro__subcollection-label clp-intro__subcollection-label--desktop">
                        {{- link_label | escape -}}
                      </span>
                      <span class="clp-intro__subcollection-label clp-intro__subcollection-label--mobile">
                        {{- mobile_label | escape -}}
                      </span>
                    </a>
                  {% else %}
                    <span
                      class="clp-intro__subcollection-link{% if navigation_image != blank %} clp-intro__subcollection-link--has-image{% endif %}"
                      aria-disabled="true"
                    >
                      {% if navigation_image != blank %}
                        <span
                          class="clp-intro__subcollection-image"
                          aria-hidden="true"
                        >
                          {{ navigation_image | image_url: width: 100, height: 100 | image_tag: loading: 'lazy', alt: '' }}
                        </span>
                      {% endif %}

                      <span class="clp-intro__subcollection-label clp-intro__subcollection-label--desktop">
                        {{- link_label | escape -}}
                      </span>
                      <span class="clp-intro__subcollection-label clp-intro__subcollection-label--mobile">
                        {{- mobile_label | escape -}}
                      </span>
                    </span>
                  {% endif %}
                </li>
              {% endfor %}
            {% endif %}
          </ul>
        </nav>
      </clp-subcollection-navigation>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .clp-intro {
    width: 100%;
    box-sizing: border-box;
    padding-block: var(--clp-intro-padding-top) var(--clp-intro-padding-bottom);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .clp-intro__inner {
    display: flex;
    width: min(
      var(--clp-intro-content-width),
      calc(100% - var(--clp-intro-desktop-gutter) - var(--clp-intro-desktop-gutter))
    );
    margin-inline: auto;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .clp-intro__heading {
    margin: 0;
    color: var(--color-foreground-heading);
    font-family: "Chronicle Display", Georgia, "Times New Roman", var(--font-heading--family), serif;
    font-size: 40px;
    font-style: normal;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: capitalize;
  }

  .clp-intro__description {
    max-width: 815px;
    color: var(--color-foreground);
    font-family: "Helvetica Neue", Helvetica, Arial, var(--font-body--family), sans-serif;
    font-size: 16px;
    font-style: normal;
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: 0;
  }

  .clp-intro__description,
  .clp-intro__description > * {
    margin: 0;
  }

  .clp-intro__description p {
    margin: 0;
  }

  .clp-intro__subcollection-navigation {
    display: block;
    width: 100%;
    margin-top: var(--clp-intro-navigation-margin-top);
    color: var(--clp-intro-navigation-text);
  }

  .clp-intro__subcollection-nav {
    width: 100%;
  }

  .clp-intro__subcollection-list {
    display: flex;
    align-items: stretch;
    gap: 16px;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-padding-inline: var(--clp-intro-desktop-gutter);
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    list-style: none;
  }

  .clp-intro__subcollection-list::-webkit-scrollbar {
    display: none;
  }

  .clp-intro__subcollection-item {
    display: flex;
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .clp-intro__subcollection-link {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 16px 32px;
    border: 1px solid var(--clp-intro-navigation-border);
    color: var(--clp-intro-navigation-text);
    font-family: "Helvetica Neue", Helvetica, Arial, var(--font-body--family), sans-serif;
    font-size: 13px;
    font-style: normal;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 1.3px;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .clp-intro__subcollection-link[aria-current='page'] {
    border-color: var(--clp-intro-navigation-active-border);
  }

  .clp-intro__subcollection-link[aria-disabled='true'] {
    cursor: default;
  }

  .clp-intro__subcollection-link:hover {
    border-color: var(--clp-intro-navigation-active-border);
  }

  .clp-intro__subcollection-link:focus-visible {
    outline: 2px solid var(--clp-intro-navigation-active-border);
    outline-offset: 3px;
  }

  .clp-intro__subcollection-label {
    display: block;
  }

  .clp-intro__subcollection-label--mobile {
    display: none;
  }

  .clp-intro__subcollection-image {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .clp-intro {
      padding-block: var(--clp-intro-padding-top-mobile) var(--clp-intro-padding-bottom-mobile);
    }

    .clp-intro__inner {
      width: calc(100% - var(--clp-intro-mobile-gutter) - var(--clp-intro-mobile-gutter));
    }

    .clp-intro__heading {
      font-size: 28px;
    }

    .clp-intro__description {
      max-width: 100%;
    }

    .clp-intro__subcollection-navigation {
      margin-top: var(--clp-intro-navigation-margin-top-mobile);
    }

    .clp-intro__subcollection-list {
      gap: 16px;
      scroll-padding-inline: var(--clp-intro-mobile-gutter);
    }

    .clp-intro__subcollection-link {
      min-height: 52px;
      padding: 16px 32px;
    }

    .clp-intro__subcollection-link--has-image {
      justify-content: flex-start;
      gap: 8px;
      min-width: 140px;
      padding: 0 20px 0 0;
    }

    .clp-intro__subcollection-image {
      display: block;
      width: 50px;
      height: 50px;
      flex: 0 0 50px;
      overflow: hidden;
    }

    .clp-intro__subcollection-image img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .clp-intro__subcollection-label--desktop {
      display: none;
    }

    .clp-intro__subcollection-label--mobile {
      display: block;
    }
  }
{% endstylesheet %}

{% javascript %}
  class ClpSubcollectionNavigation extends HTMLElement {
    connectedCallback() {
      const list = this.querySelector('[data-clp-subcollection-list]');
      const activeLink = this.querySelector('[aria-current="page"]');

      if (!list || !activeLink) return;
      if (list.scrollWidth <= list.clientWidth) return;

      requestAnimationFrame(() => {
        activeLink.scrollIntoView({ block: 'nearest', inline: 'center' });
      });
    }
  }

  if (!customElements.get('clp-subcollection-navigation')) {
    customElements.define('clp-subcollection-navigation', ClpSubcollectionNavigation);
  }
{% endjavascript %}

{% schema %}
{
  "name": "CLP intro",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["collection"]
  },
  "blocks": [
    {
      "type": "navigation_link",
      "name": "Navigation link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Desktop label"
        },
        {
          "type": "text",
          "id": "mobile_label",
          "label": "Mobile label"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading_override",
      "label": "Heading override"
    },
    {
      "type": "textarea",
      "id": "description_override",
      "label": "Description override"
    },
    {
      "type": "textarea",
      "id": "description_fallback",
      "label": "Description fallback"
    },
    {
      "type": "text",
      "id": "description_fallback_collection_handle",
      "label": "Fallback collection handle",
      "default": "all"
    },
    {
      "type": "range",
      "id": "desktop_content_width",
      "label": "Desktop content width",
      "min": 960,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "desktop_gutter",
      "label": "Desktop gutter",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_gutter",
      "label": "Mobile gutter",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 68
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Subcollection navigation"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation",
      "default": true
    },
    {
      "type": "text",
      "id": "navigation_aria_label",
      "label": "Accessible label",
      "default": "Collection categories"
    },
    {
      "type": "color",
      "id": "navigation_text_color",
      "label": "Text",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "navigation_border_color",
      "label": "Border",
      "default": "#dfdfdf"
    },
    {
      "type": "color",
      "id": "navigation_active_border_color",
      "label": "Active border",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "navigation_margin_top",
      "label": "Desktop top spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "navigation_margin_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "CLP intro"
    }
  ]
}
{% endschema %}
