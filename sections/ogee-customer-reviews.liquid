{% javascript %}
  class OgeeCustomerReviews extends HTMLElement {
    connectedCallback() {
      this.items = Array.from(this.querySelectorAll('[data-review-item]'));
      this.list = this.querySelector('[data-review-list]');
      this.filterForm = this.querySelector('[data-review-filter-form]');
      this.sortSelect = this.querySelector('[data-review-sort]');
      this.showMoreButton = this.querySelector('[data-review-show-more]');
      this.emptyMessage = this.querySelector('[data-review-empty]');
      this.initialVisible = Number(this.dataset.initialVisible) || 5;
      this.reviewsPerPage = Number(this.dataset.reviewsPerPage) || this.initialVisible;
      this.visibleCount = this.initialVisible;

      this.handleFilterChange = () => {
        this.visibleCount = this.initialVisible;
        this.update();
      };
      this.handleFilterReset = () => {
        window.requestAnimationFrame(() => {
          this.visibleCount = this.initialVisible;
          this.update();
        });
      };
      this.handleSortChange = () => {
        this.visibleCount = this.initialVisible;
        this.update();
      };
      this.handleShowMore = () => {
        this.visibleCount += this.reviewsPerPage;
        this.update();
      };

      this.filterForm?.addEventListener('change', this.handleFilterChange);
      this.filterForm?.addEventListener('reset', this.handleFilterReset);
      this.sortSelect?.addEventListener('change', this.handleSortChange);
      this.showMoreButton?.addEventListener('click', this.handleShowMore);

      this.update();
    }

    disconnectedCallback() {
      this.filterForm?.removeEventListener('change', this.handleFilterChange);
      this.filterForm?.removeEventListener('reset', this.handleFilterReset);
      this.sortSelect?.removeEventListener('change', this.handleSortChange);
      this.showMoreButton?.removeEventListener('click', this.handleShowMore);
    }

    getFilteredItems() {
      const checkedRatings = Array.from(this.querySelectorAll('[data-rating-filter]:checked')).map((input) => input.value);
      const recommendOnly = this.querySelector('[data-recommend-filter]')?.checked;

      return this.items.filter((item) => {
        const matchesRating = checkedRatings.length === 0 || checkedRatings.includes(item.dataset.reviewRating);
        const matchesRecommendation = !recommendOnly || item.dataset.reviewRecommend === 'true';
        return matchesRating && matchesRecommendation;
      });
    }

    sortItems(items) {
      const sortValue = this.sortSelect?.value || 'recent';
      const sorted = [...items];

      sorted.sort((first, second) => {
        const firstRating = Number(first.dataset.reviewRating) || 0;
        const secondRating = Number(second.dataset.reviewRating) || 0;
        const firstIndex = Number(first.dataset.reviewIndex) || 0;
        const secondIndex = Number(second.dataset.reviewIndex) || 0;

        if (sortValue === 'highest') return secondRating - firstRating || firstIndex - secondIndex;
        if (sortValue === 'lowest') return firstRating - secondRating || firstIndex - secondIndex;
        if (sortValue === 'oldest') return secondIndex - firstIndex;
        return firstIndex - secondIndex;
      });

      return sorted;
    }

    update() {
      const visibleItems = this.sortItems(this.getFilteredItems());
      const visibleSet = new Set(visibleItems.slice(0, this.visibleCount));

      visibleItems.forEach((item) => this.list?.append(item));
      this.items.forEach((item) => {
        item.hidden = !visibleSet.has(item);
      });

      if (this.emptyMessage) {
        this.emptyMessage.hidden = visibleItems.length !== 0;
      }

      if (this.showMoreButton) {
        this.showMoreButton.hidden = this.visibleCount >= visibleItems.length;
      }
    }
  }

  if (!customElements.get('ogee-customer-reviews')) {
    customElements.define('ogee-customer-reviews', OgeeCustomerReviews);
  }
{% endjavascript %}

