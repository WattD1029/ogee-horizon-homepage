{% liquid
  assign section_settings = section.settings
  assign product_resource = product
  assign average_rating = section_settings.average_rating
  assign reviews_text = section_settings.reviews_text
  assign rating_count = section_settings.rating_count
  assign review_count_display = section_settings.review_count_display

  if section_settings.use_product_rating
    if product_resource.metafields.reviews.rating.value.rating != blank
      assign average_rating = product_resource.metafields.reviews.rating.value.rating
    endif

    if product_resource.metafields.reviews.rating_count != blank
      assign rating_count = product_resource.metafields.reviews.rating_count
      capture reviews_text
        echo section_settings.reviews_prefix
        echo ' '
        echo rating_count
        echo ' '
        echo section_settings.reviews_suffix
      endcapture
      capture review_count_display
        echo rating_count
        echo ' '
        echo section_settings.reviews_suffix
      endcapture
    endif
  endif

  assign rating_floor = average_rating | floor
  assign rating_decimal = average_rating | modulo: 1
  assign rounded_star = 0
  if rating_decimal >= 0.5
    assign rounded_star = 1
  endif
  assign filled_stars = rating_floor | plus: rounded_star

  assign heading_id = 'OgeeCustomerReviewsHeading-' | append: section.id
%}

<section
  class="ogee-customer-reviews"
  aria-labelledby="{{ heading_id }}"
  style="
    --ogee-reviews-background: {{ section_settings.background_color }};
    --ogee-reviews-text: {{ section_settings.text_color }};
    --ogee-reviews-muted: {{ section_settings.muted_text_color }};
    --ogee-reviews-rule: {{ section_settings.rule_color }};
    --ogee-reviews-star: {{ section_settings.star_color }};
    --ogee-reviews-accent: {{ section_settings.accent_color }};
    --ogee-reviews-button-background: {{ section_settings.button_background_color }};
    --ogee-reviews-button-text: {{ section_settings.button_text_color }};
    --ogee-reviews-content-width: {{ section_settings.content_width }}px;
    --ogee-reviews-padding-top: {{ section_settings.padding_top }}px;
    --ogee-reviews-padding-bottom: {{ section_settings.padding_bottom }}px;
    --ogee-reviews-padding-top-mobile: {{ section_settings.padding_top_mobile }}px;
    --ogee-reviews-padding-bottom-mobile: {{ section_settings.padding_bottom_mobile }}px;
  "
>
  <ogee-customer-reviews
    class="ogee-customer-reviews__component"
    data-initial-visible="{{ section_settings.initial_reviews }}"
    data-reviews-per-page="{{ section_settings.reviews_per_page }}"
  >
    <div class="ogee-customer-reviews__inner">
      {% if section_settings.heading != blank %}
        <h2 id="{{ heading_id }}" class="ogee-customer-reviews__heading">
          {{ section_settings.heading | escape }}
        </h2>
      {% else %}
        <h2 id="{{ heading_id }}" class="visually-hidden">
          {{ section_settings.hidden_heading | escape }}
        </h2>
      {% endif %}

      <div class="ogee-customer-reviews__summary" aria-label="{{ section_settings.summary_label | escape }}">
        <div class="ogee-customer-reviews__rating-summary">
          <div class="ogee-customer-reviews__score-row">
            <span class="ogee-customer-reviews__score">{{ average_rating | round: 1 }}</span>
            <span class="ogee-customer-reviews__stars" aria-hidden="true">
              {% for star in (1..5) %}
                <svg
                  class="ogee-customer-reviews__star{% if star <= filled_stars %} ogee-customer-reviews__star--filled{% endif %}"
                  viewBox="0 0 32 32"
                  focusable="false"
                  aria-hidden="true"
                >
                  <path d="M31.547 12a.848.848 0 0 0-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 0 0-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 0 0-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 0 0 1.23.893l8.428-4.434 8.432 4.432a.847.847 0 0 0 1.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 0 0 .214-.869z"></path>
                </svg>
              {% endfor %}
            </span>
            <span class="ogee-customer-reviews__based">{{ reviews_text | escape }}</span>
          </div>

          <div class="ogee-customer-reviews__distribution" aria-label="{{ section_settings.distribution_label | escape }}">
            <div class="ogee-customer-reviews__distribution-row" style="--rating-fill: {{ section_settings.rating_5_percent }}%;">
              <span class="ogee-customer-reviews__distribution-label">5</span>
              <span class="ogee-customer-reviews__distribution-star" aria-hidden="true">
                <svg viewBox="0 0 32 32" focusable="false" aria-hidden="true">
                  <path d="M31.547 12a.848.848 0 0 0-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 0 0-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 0 0-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 0 0 1.23.893l8.428-4.434 8.432 4.432a.847.847 0 0 0 1.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 0 0 .214-.869z"></path>
                </svg>
              </span>
              <span class="ogee-customer-reviews__bar" aria-hidden="true"><span></span></span>
              <span class="ogee-customer-reviews__distribution-count">{{ section_settings.rating_5_count_text | escape }}</span>
            </div>
            <div class="ogee-customer-reviews__distribution-row" style="--rating-fill: {{ section_settings.rating_4_percent }}%;">
              <span class="ogee-customer-reviews__distribution-label">4</span>
              <span class="ogee-customer-reviews__distribution-star" aria-hidden="true">
                <svg viewBox="0 0 32 32" focusable="false" aria-hidden="true">
                  <path d="M31.547 12a.848.848 0 0 0-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 0 0-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 0 0-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 0 0 1.23.893l8.428-4.434 8.432 4.432a.847.847 0 0 0 1.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 0 0 .214-.869z"></path>
                </svg>
              </span>
              <span class="ogee-customer-reviews__bar" aria-hidden="true"><span></span></span>
              <span class="ogee-customer-reviews__distribution-count">{{ section_settings.rating_4_count_text | escape }}</span>
            </div>
            <div class="ogee-customer-reviews__distribution-row" style="--rating-fill: {{ section_settings.rating_3_percent }}%;">
              <span class="ogee-customer-reviews__distribution-label">3</span>
              <span class="ogee-customer-reviews__distribution-star" aria-hidden="true">
                <svg viewBox="0 0 32 32" focusable="false" aria-hidden="true">
                  <path d="M31.547 12a.848.848 0 0 0-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 0 0-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 0 0-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 0 0 1.23.893l8.428-4.434 8.432 4.432a.847.847 0 0 0 1.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 0 0 .214-.869z"></path>
                </svg>
              </span>
              <span class="ogee-customer-reviews__bar" aria-hidden="true"><span></span></span>
              <span class="ogee-customer-reviews__distribution-count">{{ section_settings.rating_3_count_text | escape }}</span>
            </div>
            <div class="ogee-customer-reviews__distribution-row" style="--rating-fill: {{ section_settings.rating_2_percent }}%;">
              <span class="ogee-customer-reviews__distribution-label">2</span>
              <span class="ogee-customer-reviews__distribution-star" aria-hidden="true">
                <svg viewBox="0 0 32 32" focusable="false" aria-hidden="true">
                  <path d="M31.547 12a.848.848 0 0 0-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 0 0-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 0 0-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 0 0 1.23.893l8.428-4.434 8.432 4.432a.847.847 0 0 0 1.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 0 0 .214-.869z"></path>
                </svg>
              </span>
              <span class="ogee-customer-reviews__bar" aria-hidden="true"><span></span></span>
              <span class="ogee-customer-reviews__distribution-count">{{ section_settings.rating_2_count_text | escape }}</span>
            </div>
            <div class="ogee-customer-reviews__distribution-row" style="--rating-fill: {{ section_settings.rating_1_percent }}%;">
              <span class="ogee-customer-reviews__distribution-label">1</span>
              <span class="ogee-customer-reviews__distribution-star" aria-hidden="true">
                <svg viewBox="0 0 32 32" focusable="false" aria-hidden="true">
                  <path d="M31.547 12a.848.848 0 0 0-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 0 0-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 0 0-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 0 0 1.23.893l8.428-4.434 8.432 4.432a.847.847 0 0 0 1.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 0 0 .214-.869z"></path>
                </svg>
              </span>
              <span class="ogee-customer-reviews__bar" aria-hidden="true"><span></span></span>
              <span class="ogee-customer-reviews__distribution-count">{{ section_settings.rating_1_count_text | escape }}</span>
            </div>
          </div>
        </div>

        <div class="ogee-customer-reviews__fit-summary">
          <p class="ogee-customer-reviews__recommendation">
            <strong>{{ section_settings.recommendation_percent }}%</strong>
            <span>{{ section_settings.recommendation_text | escape }}</span>
          </p>

          <div class="ogee-customer-reviews__scale" style="--scale-value: {{ section_settings.effect_value }}%;">
            <p class="ogee-customer-reviews__scale-heading">{{ section_settings.effect_heading | escape }}</p>
            <div
              class="ogee-customer-reviews__scale-line"
              role="img"
              aria-label="{{ section_settings.effect_heading | escape }}: {{ section_settings.effect_value }}%"
            >
              <span class="ogee-customer-reviews__scale-marker"></span>
              <span class="ogee-customer-reviews__scale-marker"></span>
              <span class="ogee-customer-reviews__scale-marker"></span>
              <span class="ogee-customer-reviews__scale-marker"></span>
              <span class="ogee-customer-reviews__scale-marker"></span>
              <span class="ogee-customer-reviews__scale-marker"></span>
              <span class="ogee-customer-reviews__scale-active"></span>
            </div>
            <div class="ogee-customer-reviews__scale-labels">
              <span>{{ section_settings.effect_min_label | escape }}</span>
              <span>{{ section_settings.effect_max_label | escape }}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="ogee-customer-reviews__controls">
        <details class="ogee-customer-reviews__filters" data-review-filters>
          <summary class="ogee-customer-reviews__filter-button">
            <span class="ogee-customer-reviews__filter-icon" aria-hidden="true">
              {{ 'icon-filter.svg' | inline_asset_content }}
            </span>
            <span>{{ section_settings.filters_label | escape }}</span>
          </summary>
          <form class="ogee-customer-reviews__filter-panel" data-review-filter-form>
            <fieldset>
              <legend>{{ section_settings.filter_rating_label | escape }}</legend>
              {% for rating_option in (1..5) reversed %}
                <label>
                  <input type="checkbox" value="{{ rating_option }}" data-rating-filter>
                  <span>{{ rating_option }} {{ section_settings.filter_star_label | escape }}</span>
                </label>
              {% endfor %}
            </fieldset>
            <fieldset>
              <legend>{{ section_settings.filter_recommend_label | escape }}</legend>
              <label>
                <input type="checkbox" data-recommend-filter>
                <span>{{ section_settings.filter_recommend_option | escape }}</span>
              </label>
            </fieldset>
            <button type="reset" class="ogee-customer-reviews__clear-filters">
              {{ section_settings.clear_filters_label | escape }}
            </button>
          </form>
        </details>

        <p class="ogee-customer-reviews__review-count" aria-live="polite" data-review-count>
          {{ review_count_display | escape }}
        </p>

        <label class="ogee-customer-reviews__sort" for="OgeeReviewsSort-{{ section.id }}">
          <span>{{ section_settings.sort_label | escape }}</span>
          <select id="OgeeReviewsSort-{{ section.id }}" data-review-sort>
            <option value="recent">{{ section_settings.sort_recent_label | escape }}</option>
            <option value="highest">{{ section_settings.sort_highest_label | escape }}</option>
            <option value="lowest">{{ section_settings.sort_lowest_label | escape }}</option>
            <option value="oldest">{{ section_settings.sort_oldest_label | escape }}</option>
          </select>
        </label>
      </div>

      <ul class="ogee-customer-reviews__list" data-review-list>
        {% for block in section.blocks %}
          {% liquid
            assign block_settings = block.settings
            assign review_rating = block_settings.rating
            assign is_recommended = 'false'
            if block_settings.recommends_product
              assign is_recommended = 'true'
            endif
          %}

          <li
            class="ogee-customer-reviews__item"
            data-review-item
            data-review-rating="{{ review_rating }}"
            data-review-recommend="{{ is_recommended }}"
            data-review-index="{{ forloop.index0 }}"
            {% if forloop.index > section_settings.initial_reviews %}
              hidden
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <div class="ogee-customer-reviews__reviewer">
              <p class="ogee-customer-reviews__author">
                <strong>{{ block_settings.reviewer_name | escape }}</strong>
                {% if block_settings.verified %}
                  <span>{{ block_settings.verified_label | escape }}</span>
                  <span class="ogee-customer-reviews__verified-icon" aria-hidden="true">
                    {{ 'icon-checkmark.svg' | inline_asset_content }}
                  </span>
                {% endif %}
              </p>

              {% if block_settings.recommends_product %}
                <p class="ogee-customer-reviews__recommends">
                  <span aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
                  {{ block_settings.recommendation_label | escape }}
                </p>
              {% endif %}

              {% if block_settings.skin_tone != blank %}
                <p class="ogee-customer-reviews__attribute">
                  <strong>{{ block_settings.skin_tone_label | escape }}</strong>
                  <span>{{ block_settings.skin_tone | escape }}</span>
                </p>
              {% endif %}

              {% if block_settings.skin_concern != blank %}
                <p class="ogee-customer-reviews__attribute">
                  <strong>{{ block_settings.skin_concern_label | escape }}</strong>
                  <span>{{ block_settings.skin_concern | escape }}</span>
                </p>
              {% endif %}

              {% if block_settings.values != blank %}
                <p class="ogee-customer-reviews__attribute ogee-customer-reviews__attribute--stacked">
                  <strong>{{ block_settings.values_label | escape }}</strong>
                  <span>{{ block_settings.values | escape }}</span>
                </p>
              {% endif %}
            </div>

            <div class="ogee-customer-reviews__body">
              <div class="ogee-customer-reviews__item-stars" aria-label="{{ section_settings.review_rating_label | escape }} {{ review_rating }}">
                {% for star in (1..5) %}
                  <svg
                    class="ogee-customer-reviews__star{% if star <= review_rating %} ogee-customer-reviews__star--filled{% endif %}"
                    viewBox="0 0 32 32"
                    focusable="false"
                    aria-hidden="true"
                  >
                    <path d="M31.547 12a.848.848 0 0 0-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 0 0-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 0 0-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 0 0 1.23.893l8.428-4.434 8.432 4.432a.847.847 0 0 0 1.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 0 0 .214-.869z"></path>
                  </svg>
                {% endfor %}
              </div>

              {% if block_settings.title != blank %}
                <h3 class="ogee-customer-reviews__title">{{ block_settings.title | escape }}</h3>
              {% endif %}

              {% if block_settings.body != blank %}
                <p class="ogee-customer-reviews__copy">{{ block_settings.body | escape }}</p>
              {% endif %}

              <div class="ogee-customer-reviews__helpful">
                <span>{{ section_settings.helpful_label | escape }}</span>
                <span class="ogee-customer-reviews__vote" aria-label="{{ section_settings.helpful_yes_label | escape }}">
                  <svg viewBox="0 0 16 16" focusable="false" aria-hidden="true">
                    <path d="M5.7 14H3.2A1.2 1.2 0 0 1 2 12.8V7.9c0-.66.54-1.2 1.2-1.2h2.5V14Zm1.1 0V6.6l2.3-4.5c.17-.33.52-.52.89-.48.59.06 1.01.59.93 1.18l-.47 3.24h2.25c.82 0 1.44.74 1.3 1.55l-.85 5.1A1.56 1.56 0 0 1 11.6 14H6.8Z"></path>
                  </svg>
                  {{ block_settings.helpful_yes | escape }}
                </span>
                <span class="ogee-customer-reviews__vote" aria-label="{{ section_settings.helpful_no_label | escape }}">
                  <svg viewBox="0 0 16 16" focusable="false" aria-hidden="true">
                    <path d="M10.3 2h2.5A1.2 1.2 0 0 1 14 3.2v4.9c0 .66-.54 1.2-1.2 1.2h-2.5V2ZM9.2 2v7.4l-2.3 4.5c-.17.33-.52.52-.89.48-.59-.06-1.01-.59-.93-1.18l.47-3.24H3.3c-.82 0-1.44-.74-1.3-1.55l.85-5.1A1.56 1.56 0 0 1 4.4 2h4.8Z"></path>
                  </svg>
                  {{ block_settings.helpful_no | escape }}
                </span>
              </div>
            </div>

            <p class="ogee-customer-reviews__date">{{ block_settings.date_label | escape }}</p>
          </li>
        {% endfor %}
      </ul>

      <p class="ogee-customer-reviews__empty" data-review-empty hidden>
        {{ section_settings.empty_message | escape }}
      </p>

      {% if section.blocks.size > section_settings.initial_reviews %}
        <div class="ogee-customer-reviews__show-more-wrap">
          <button type="button" class="ogee-customer-reviews__show-more" data-review-show-more>
            {{ section_settings.show_more_label | escape }}
          </button>
        </div>
      {% endif %}
    </div>
  </ogee-customer-reviews>
</section>

{% stylesheet %}
  .ogee-customer-reviews {
    background: var(--ogee-reviews-background);
    color: var(--ogee-reviews-text);
    padding-block: var(--ogee-reviews-padding-top-mobile) var(--ogee-reviews-padding-bottom-mobile);
  }

  .ogee-customer-reviews__component,
  .ogee-customer-reviews__inner {
    display: block;
  }

  .ogee-customer-reviews__inner {
    width: min(var(--ogee-reviews-content-width), calc(100vw - 30px));
    margin-inline: auto;
  }

  .ogee-customer-reviews__heading {
    margin: 0 0 28px;
    color: var(--ogee-reviews-text);
    font-family: 'Chronicle Display', 'Chronicle Display Light', Georgia, 'Times New Roman', serif;
    font-size: 28px;
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: 0;
    text-align: center;
  }

  .ogee-customer-reviews__summary {
    display: grid;
    gap: 32px;
  }

  .ogee-customer-reviews__rating-summary {
    display: grid;
    justify-items: center;
    gap: 18px;
  }

  .ogee-customer-reviews__score-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 11px 18px;
    color: var(--ogee-reviews-muted);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 17px;
    line-height: 1.2;
  }

  .ogee-customer-reviews__score {
    color: var(--ogee-reviews-muted);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0;
  }

  .ogee-customer-reviews__stars,
  .ogee-customer-reviews__item-stars {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  .ogee-customer-reviews__star {
    width: 20px;
    height: 20px;
    fill: rgb(0 0 0 / 0.15);
  }

  .ogee-customer-reviews__star--filled {
    fill: var(--ogee-reviews-star);
  }

  .ogee-customer-reviews__based {
    font-size: 17px;
    letter-spacing: 0;
  }

  .ogee-customer-reviews__distribution {
    display: grid;
    width: min(100%, 520px);
    gap: 11px;
  }

  .ogee-customer-reviews__distribution-row {
    display: grid;
    grid-template-columns: 20px 20px minmax(0, 1fr) 54px;
    align-items: center;
    gap: 8px;
    color: var(--ogee-reviews-muted);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 17px;
    line-height: 1;
  }

  .ogee-customer-reviews__distribution-star svg {
    display: block;
    width: 18px;
    height: 18px;
    fill: var(--ogee-reviews-star);
  }

  .ogee-customer-reviews__bar {
    display: block;
    height: 6px;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.04);
  }

  .ogee-customer-reviews__bar span {
    display: block;
    width: var(--rating-fill);
    height: 100%;
    border-radius: inherit;
    background: var(--ogee-reviews-muted);
  }

  .ogee-customer-reviews__distribution-count {
    text-align: right;
  }

  .ogee-customer-reviews__fit-summary {
    display: grid;
    align-content: start;
    gap: 30px;
    color: var(--ogee-reviews-muted);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .ogee-customer-reviews__recommendation {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 11px;
    margin: 0;
    color: var(--ogee-reviews-muted);
    font-size: 17px;
    line-height: 1.2;
  }

  .ogee-customer-reviews__recommendation strong {
    color: var(--ogee-reviews-muted);
    font-size: 24px;
    font-weight: 700;
  }

  .ogee-customer-reviews__scale {
    display: grid;
    gap: 15px;
  }

  .ogee-customer-reviews__scale-heading {
    margin: 0;
    color: var(--ogee-reviews-muted);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ogee-customer-reviews__scale-line {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 18px;
  }

  .ogee-customer-reviews__scale-line::before {
    content: "";
    position: absolute;
    left: 3px;
    right: 3px;
    top: 50%;
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(
      to right,
      var(--ogee-reviews-muted) 0,
      var(--ogee-reviews-muted) var(--scale-value),
      rgb(0 0 0 / 0.12) var(--scale-value),
      rgb(0 0 0 / 0.12) 100%
    );
    transform: translateY(-50%);
  }

  .ogee-customer-reviews__scale-marker {
    position: relative;
    z-index: 1;
    width: 8px;
    height: 8px;
    border-radius: 50%;
