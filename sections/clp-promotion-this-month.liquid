{% liquid
  assign section_settings = section.settings
  assign cta_url = section_settings.link
  assign cta_label = section_settings.button_label
  assign cta_aria_label = cta_label

  if cta_url == blank
    if section_settings.collection != blank
      assign cta_url = section_settings.collection.url
    endif
  endif

  if cta_url == blank
    if section_settings.fallback_collection_handle != blank
      assign fallback_collection_handle = section_settings.fallback_collection_handle | handleize
      assign collection_path = routes.root_url | append: '/collections/' | append: fallback_collection_handle
      assign cta_url = collection_path | replace: '//collections/', '/collections/'
    endif
  endif

  if cta_label == blank
    assign cta_label = 'actions.view_all' | t
  endif

  assign cta_aria_label = cta_label

  if section_settings.heading != blank
    assign cta_aria_label = cta_label | append: ': ' | append: section_settings.heading
  endif

  assign image_alt = section_settings.image_alt
  if image_alt == blank
    assign image_alt = section_settings.heading
  endif

  assign loading = 'lazy'
  assign fetch_priority = 'low'

  if section.index <= 3
    assign loading = 'eager'
  endif

  if section.index == 1
    assign fetch_priority = 'high'
  endif
%}

<section
  class="clp-promotion-this-month color-{{ section_settings.color_scheme }}"
  style="
    --clp-promotion-width: {{ section_settings.desktop_content_width }}px;
    --clp-promotion-mobile-width: {{ section_settings.mobile_content_width }}px;
    --clp-promotion-background: {{ section_settings.panel_background }};
    --clp-promotion-text: {{ section_settings.text_color }};
    --clp-promotion-muted: {{ section_settings.muted_text_color }};
    --clp-promotion-rule: {{ section_settings.border_color }};
    --clp-promotion-button-background: {{ section_settings.button_background }};
    --clp-promotion-button-color: {{ section_settings.button_color }};
    --clp-promotion-padding-top: {{ section_settings.padding_top }}px;
    --clp-promotion-padding-bottom: {{ section_settings.padding_bottom }}px;
    --clp-promotion-mobile-padding-top: {{ section_settings.padding_top_mobile }}px;
    --clp-promotion-mobile-padding-bottom: {{ section_settings.padding_bottom_mobile }}px;
  "
>
  <div class="clp-promotion-this-month__inner">
    {% if section_settings.heading != blank %}
      <h2 class="clp-promotion-this-month__heading clp-promotion-this-month__heading--mobile">
        {{ section_settings.heading | escape }}
      </h2>
    {% endif %}

    <div class="clp-promotion-this-month__media">
      {% if section_settings.image != blank %}
        {{
          section_settings.image
          | image_url: width: 1400
          | image_tag:
            widths: '350, 500, 700, 1000, 1200, 1400',
            sizes: '(min-width: 990px) 500px, min(100vw - 40px, 350px)',
            loading: loading,
            fetchpriority: fetch_priority,
            alt: image_alt,
            class: 'clp-promotion-this-month__image'
        }}
      {% else %}
        <img
          src="{{ 'social-proof-products.png' | asset_url }}"
          alt="{{ image_alt | escape }}"
          class="clp-promotion-this-month__image"
          width="1080"
          height="1620"
          loading="{{ loading }}"
          fetchpriority="{{ fetch_priority }}"
        >
      {% endif %}
    </div>

    <div class="clp-promotion-this-month__content">
      {% if section_settings.heading != blank %}
        <h2 class="clp-promotion-this-month__heading clp-promotion-this-month__heading--desktop">
          {{ section_settings.heading | escape }}
        </h2>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="clp-promotion-this-month__offers">
          {% for block in section.blocks %}
            {% if block.settings.title != blank %}
              <details
                class="clp-promotion-this-month__offer"
                {% if block.settings.open_by_default %}
                  open
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <summary class="clp-promotion-this-month__summary">
                  <span>{{ block.settings.title | escape }}</span>
                  <span class="clp-promotion-this-month__icon" aria-hidden="true">
                    {{ 'icon-caret.svg' | inline_asset_content }}
                  </span>
                </summary>

                {% if block.settings.body != blank %}
                  <div class="clp-promotion-this-month__body">
                    {{ block.settings.body }}
                  </div>
                {% endif %}
              </details>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if cta_url != blank %}
        <a
          class="clp-promotion-this-month__button"
          href="{{ cta_url }}"
          aria-label="{{ cta_aria_label | escape }}"
          {% if section_settings.open_in_new_tab %}
            target="_blank"
            rel="noopener"
          {% endif %}
        >
          {{ cta_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .clp-promotion-this-month {
    background: rgb(var(--color-background-rgb));
    padding-block: var(--clp-promotion-padding-top) var(--clp-promotion-padding-bottom);
  }

  .clp-promotion-this-month__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    margin-inline: auto;
    max-width: min(100%, var(--clp-promotion-width));
  }

  .clp-promotion-this-month__media {
    background: var(--clp-promotion-background);
    min-height: 500px;
    overflow: hidden;
  }

  .clp-promotion-this-month__image {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .clp-promotion-this-month__content {
    align-items: flex-start;
    background: var(--clp-promotion-background);
    color: var(--clp-promotion-text);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 58px 74px;
  }

  .clp-promotion-this-month__heading {
    color: var(--clp-promotion-text);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 32px;
    font-style: normal;
    font-weight: 300;
    letter-spacing: 0;
    line-height: 1.2;
    margin: 0;
    text-wrap: pretty;
  }

  .clp-promotion-this-month__heading--desktop {
    margin-block-end: 48px;
  }

  .clp-promotion-this-month__heading--mobile {
    display: none;
  }

  .clp-promotion-this-month__offers {
    max-width: 420px;
    width: 100%;
  }

  .clp-promotion-this-month__offer {
    border-bottom: 1px solid var(--clp-promotion-rule);
  }

  .clp-promotion-this-month__summary {
    align-items: center;
    color: var(--clp-promotion-text);
    cursor: pointer;
    display: flex;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-style: normal;
    font-weight: 500;
    justify-content: space-between;
    letter-spacing: 0.65px;
    line-height: 1.3;
    list-style: none;
    min-height: 52px;
    text-transform: uppercase;
  }

  .clp-promotion-this-month__summary::-webkit-details-marker {
    display: none;
  }

  .clp-promotion-this-month__icon {
    align-items: center;
    display: inline-flex;
    flex: 0 0 auto;
    height: 16px;
    justify-content: center;
    margin-inline-start: 20px;
    transition: transform var(--animation-speed, 200ms) var(--animation-easing, ease);
    width: 16px;
  }

  .clp-promotion-this-month__icon svg {
    display: block;
    height: 10px;
    width: 10px;
  }

  .clp-promotion-this-month__offer[open] .clp-promotion-this-month__icon {
    transform: rotate(180deg);
  }

  .clp-promotion-this-month__body {
    color: var(--clp-promotion-muted);
    font-family: var(--font-body--family);
    font-size: 13px;
    font-style: normal;
    font-weight: 300;
    letter-spacing: 0;
    line-height: 1.55;
    max-width: 380px;
    padding-block: 0 20px;
  }

  .clp-promotion-this-month__body p {
    margin-block: 0;
  }

  .clp-promotion-this-month__button {
    align-items: center;
    background: var(--clp-promotion-button-background);
    border: 1px solid var(--clp-promotion-button-background);
    border-radius: 0;
    color: var(--clp-promotion-button-color);
    display: inline-flex;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-style: normal;
    font-weight: 500;
    justify-content: center;
    letter-spacing: 1.3px;
    line-height: 1;
    margin-block-start: 28px;
    min-height: 42px;
    min-width: 180px;
    padding: 14px 32px;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .clp-promotion-this-month__button:hover {
    background: transparent;
    color: var(--clp-promotion-button-background);
  }

  .clp-promotion-this-month__button:focus-visible,
  .clp-promotion-this-month__summary:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 4px;
  }

  @media screen and (max-width: 989px) {
    .clp-promotion-this-month {
      padding-block: var(--clp-promotion-mobile-padding-top) var(--clp-promotion-mobile-padding-bottom);
      padding-inline: 20px;
    }

    .clp-promotion-this-month__inner {
      display: block;
      max-width: min(100%, var(--clp-promotion-mobile-width));
    }

    .clp-promotion-this-month__heading {
      font-size: 26px;
      line-height: 1.2;
      text-align: center;
    }

    .clp-promotion-this-month__heading--mobile {
      display: block;
      margin-block-end: 24px;
    }

    .clp-promotion-this-month__heading--desktop {
      display: none;
    }

    .clp-promotion-this-month__media {
      aspect-ratio: 350 / 199;
      min-height: 0;
    }

    .clp-promotion-this-month__content {
      padding: 32px 24px;
    }

    .clp-promotion-this-month__offers,
    .clp-promotion-this-month__body {
      max-width: none;
    }

    .clp-promotion-this-month__summary {
      font-size: 12px;
      letter-spacing: 0.6px;
      min-height: 46px;
    }

    .clp-promotion-this-month__body {
      font-size: 12px;
      line-height: 1.6;
    }

    .clp-promotion-this-month__button {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CLP Promotion This Month",
  "tag": "section",
  "class": "clp-promotion-this-month-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "blocks": [
    {
      "type": "offer",
      "name": "Offer",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Get free gift with purchase of $150+"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>You'll receive our Deluxe Sample Botanical Brilliance Exfoliating Cleanser and Jojoba Glow Face Oil with your purchase of $150+!</p>"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Promotion This Month"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Ogee products arranged in natural light"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "Shop bestsellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Custom link"
    },
    {
      "type": "text",
      "id": "fallback_collection_handle",
      "label": "Fallback collection handle",
      "default": "bestsellers"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_content_width",
      "label": "Desktop content width",
      "min": 900,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1000
    },
    {
      "type": "range",
      "id": "mobile_content_width",
      "label": "Mobile content width",
      "min": 300,
      "max": 390,
      "step": 5,
      "unit": "px",
      "default": 350
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Panel background",
      "default": "#fafafa"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Rules",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "CLP Promotion This Month",
      "blocks": {
        "gift_with_purchase": {
          "type": "offer",
          "settings": {
            "title": "Get free gift with purchase of $150+",
            "body": "<p>You'll receive our Deluxe Sample Botanical Brilliance Exfoliating Cleanser and Jojoba Glow Face Oil with your purchase of $150+!</p>",
            "open_by_default": true
          }
        },
        "subscription": {
          "type": "offer",
          "settings": {
            "title": "Save more with subscription",
            "body": "<p>Subscribe to your Ogee favorites and save on every replenishment while keeping your routine fully stocked.</p>",
            "open_by_default": false
          }
        },
        "shipping": {
          "type": "offer",
          "settings": {
            "title": "Free shipping all order $75+",
            "body": "<p>Enjoy free shipping on qualifying orders of $75 or more.</p>",
            "open_by_default": false
          }
        }
      },
      "block_order": ["gift_with_purchase", "subscription", "shipping"]
    }
  ]
}
{% endschema %}
