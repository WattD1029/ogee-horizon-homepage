{% if section.blocks.size > 0 %}
  <section
    class="subcollection-navigation color-{{ section.settings.color_scheme }}"
    style="
      --subcollection-navigation-content-width: {{ section.settings.desktop_content_width }}px;
      --subcollection-navigation-desktop-gutter: {{ section.settings.desktop_gutter }}px;
      --subcollection-navigation-mobile-gutter: {{ section.settings.mobile_gutter }}px;
      --subcollection-navigation-padding-top: {{ section.settings.padding_top }}px;
      --subcollection-navigation-padding-bottom: {{ section.settings.padding_bottom }}px;
      --subcollection-navigation-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
      --subcollection-navigation-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
      --subcollection-navigation-text: {{ section.settings.text_color }};
      --subcollection-navigation-border: {{ section.settings.border_color }};
      --subcollection-navigation-active-border: {{ section.settings.active_border_color }};
    "
  >
    <subcollection-navigation class="subcollection-navigation__inner">
      <nav
        class="subcollection-navigation__nav"
        aria-label="{{ section.settings.aria_label | escape }}"
      >
        <ul
          class="subcollection-navigation__list"
          data-subcollection-navigation-list
        >
          {% for block in section.blocks %}
            {% liquid
              assign target_collection = block.settings.collection
              assign link_label = block.settings.label

              if link_label == blank
                if target_collection != blank
                  assign link_label = target_collection.title
                endif
              endif

              assign mobile_label = block.settings.mobile_label

              if mobile_label == blank
                assign mobile_label = link_label
              endif

              assign link_url = block.settings.link

              if link_url == blank
                if target_collection != blank
                  assign link_url = target_collection.url
                endif
              endif

              assign is_current = false

              if collection != blank
                if target_collection != blank
                  if target_collection.id == collection.id
                    assign is_current = true
                  endif
                endif
              endif
            %}

            {% if link_label != blank %}
              <li
                class="subcollection-navigation__item"
                {{ block.shopify_attributes }}
              >
                {% if link_url != blank %}
                  <a
                    class="subcollection-navigation__link"
                    href="{{ link_url }}"
                    {% if is_current %}
                      aria-current="page"
                    {% endif %}
                  >
                    <span class="subcollection-navigation__label subcollection-navigation__label--desktop">
                      {{- link_label | escape -}}
                    </span>
                    <span class="subcollection-navigation__label subcollection-navigation__label--mobile">
                      {{- mobile_label | escape -}}
                    </span>
                  </a>
                {% else %}
                  <span
                    class="subcollection-navigation__link"
                    aria-disabled="true"
                  >
                    <span class="subcollection-navigation__label subcollection-navigation__label--desktop">
                      {{- link_label | escape -}}
                    </span>
                    <span class="subcollection-navigation__label subcollection-navigation__label--mobile">
                      {{- mobile_label | escape -}}
                    </span>
                  </span>
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </nav>
    </subcollection-navigation>
  </section>
{% endif %}

{% stylesheet %}
  .subcollection-navigation {
    width: 100%;
    box-sizing: border-box;
    padding-block: var(--subcollection-navigation-padding-top) var(--subcollection-navigation-padding-bottom);
    background: var(--color-background);
    color: var(--subcollection-navigation-text);
  }

  .subcollection-navigation__inner {
    display: block;
    width: min(
      var(--subcollection-navigation-content-width),
      calc(100% - var(--subcollection-navigation-desktop-gutter) - var(--subcollection-navigation-desktop-gutter))
    );
    margin-inline: auto;
  }

  .subcollection-navigation__nav {
    width: 100%;
  }

  .subcollection-navigation__list {
    display: flex;
    align-items: stretch;
    gap: 16px;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-padding-inline: var(--subcollection-navigation-desktop-gutter);
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    list-style: none;
  }

  .subcollection-navigation__list::-webkit-scrollbar {
    display: none;
  }

  .subcollection-navigation__item {
    display: flex;
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .subcollection-navigation__link {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 16px 32px;
    border: 1px solid var(--subcollection-navigation-border);
    color: var(--subcollection-navigation-text);
    font-family: "Helvetica Neue", Helvetica, Arial, var(--font-body--family), sans-serif;
    font-size: 13px;
    font-style: normal;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 1.3px;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .subcollection-navigation__link[aria-current='page'] {
    border-color: var(--subcollection-navigation-active-border);
  }

  .subcollection-navigation__link[aria-disabled='true'] {
    cursor: default;
  }

  .subcollection-navigation__link:hover {
    border-color: var(--subcollection-navigation-active-border);
  }

  .subcollection-navigation__link:focus-visible {
    outline: 2px solid var(--subcollection-navigation-active-border);
    outline-offset: 3px;
  }

  .subcollection-navigation__label {
    display: block;
  }

  .subcollection-navigation__label--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .subcollection-navigation {
      padding-block: var(--subcollection-navigation-padding-top-mobile)
        var(--subcollection-navigation-padding-bottom-mobile);
    }

    .subcollection-navigation__inner {
      width: calc(100% - var(--subcollection-navigation-mobile-gutter) - var(--subcollection-navigation-mobile-gutter));
    }

    .subcollection-navigation__list {
      gap: 8px;
      scroll-padding-inline: var(--subcollection-navigation-mobile-gutter);
    }

    .subcollection-navigation__link {
      min-height: 40px;
      padding: 12px 16px;
    }

    .subcollection-navigation__label--desktop {
      display: none;
    }

    .subcollection-navigation__label--mobile {
      display: block;
    }
  }
{% endstylesheet %}

{% javascript %}
  class SubcollectionNavigation extends HTMLElement {
    connectedCallback() {
      const list = this.querySelector('[data-subcollection-navigation-list]');
      const activeLink = this.querySelector('[aria-current="page"]');

      if (!list || !activeLink) return;
      if (list.scrollWidth <= list.clientWidth) return;

      requestAnimationFrame(() => {
        activeLink.scrollIntoView({ block: 'nearest', inline: 'center' });
      });
    }
  }

  if (!customElements.get('subcollection-navigation')) {
    customElements.define('subcollection-navigation', SubcollectionNavigation);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Subcollection navigation",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["collection"]
  },
  "blocks": [
    {
      "type": "link",
      "name": "Collection link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Desktop label"
        },
        {
          "type": "text",
          "id": "mobile_label",
          "label": "Mobile label"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessible label",
      "default": "Collection categories"
    },
    {
      "type": "range",
      "id": "desktop_content_width",
      "label": "Desktop content width",
      "min": 960,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "desktop_gutter",
      "label": "Desktop gutter",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_gutter",
      "label": "Mobile gutter",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#dfdfdf"
    },
    {
      "type": "color",
      "id": "active_border_color",
      "label": "Active border",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Subcollection navigation",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "All",
            "collection": "all"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Bestseller",
            "mobile_label": "Bestsellers",
            "collection": "bestsellers"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "New",
            "collection": "new"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Makeup",
            "collection": "makeup"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Skincare",
            "collection": "skincare"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Bundles",
            "collection": "bundles"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Accessories",
            "collection": "accessories"
          }
        }
      ]
    }
  ]
}
{% endschema %}
