{% javascript %}
  class OgeeProductMedia extends HTMLElement {
    connectedCallback() {
      this.buttons = Array.from(this.querySelectorAll('[data-ogee-media-button]'));
      this.panels = Array.from(this.querySelectorAll('[data-ogee-media-panel]'));
      this.progress = this.querySelector('[data-ogee-media-progress]');
      this.activeGalleryKey = this.dataset.ogeeInitialGalleryKey || this.panels[0]?.dataset.ogeeGalleryKey || 'base';
      this.index = 0;
      this.addEventListener('click', this.handleClick);
      this.update();
    }

    disconnectedCallback() {
      this.removeEventListener('click', this.handleClick);
    }

    handleClick = (event) => {
      const button = event.target.closest('[data-ogee-media-button]');
      const previous = event.target.closest('[data-ogee-media-prev]');
      const next = event.target.closest('[data-ogee-media-next]');

      if (button) {
        this.activeGalleryKey = button.dataset.ogeeGalleryKey || this.activeGalleryKey;
        this.selectIndex(Number(button.dataset.ogeeMediaIndex) || 0);
      }

      if (previous) {
        const panels = this.activePanels();
        this.selectIndex((this.index - 1 + panels.length) % panels.length);
      }

      if (next) {
        const panels = this.activePanels();
        this.selectIndex((this.index + 1) % panels.length);
      }
    };

    activePanels() {
      return this.panels.filter((panel) => (panel.dataset.ogeeGalleryKey || 'base') === this.activeGalleryKey);
    }

    selectIndex(index) {
      const panels = this.activePanels();

      if (panels.length === 0) return;

      this.index = Math.max(0, Math.min(index, panels.length - 1));
      this.update();
    }

    selectMediaId(mediaId) {
      const panel = this.panels.find((item) => item.dataset.ogeeMediaId === String(mediaId));

      if (!panel) return false;

      this.activeGalleryKey = panel.dataset.ogeeGalleryKey || this.activeGalleryKey;
      this.selectIndex(Number(panel.dataset.ogeeMediaIndex) || 0);
      return true;
    }

    selectVariantId(variantId) {
      const panel = this.panels.find((item) => item.dataset.ogeeVariantId === String(variantId));

      if (!panel) return false;

      this.activeGalleryKey = panel.dataset.ogeeGalleryKey || `variant-${variantId}`;
      this.selectIndex(Number(panel.dataset.ogeeMediaIndex) || 0);
      return true;
    }

    update() {
      const activePanels = this.activePanels();
      const activePanel = activePanels[this.index] || activePanels[0];

      if (!activePanel) return;

      this.index = activePanels.indexOf(activePanel);

      this.panels.forEach((panel) => {
        panel.hidden = panel !== activePanel;
      });

      this.buttons.forEach((button) => {
        const galleryMatches = (button.dataset.ogeeGalleryKey || 'base') === this.activeGalleryKey;
        const active = galleryMatches && Number(button.dataset.ogeeMediaIndex) === this.index;
        button.hidden = !galleryMatches;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-current', active ? 'true' : 'false');
      });

      if (this.progress && activePanels.length > 0) {
        this.progress.style.setProperty('--ogee-progress', `${((this.index + 1) / activePanels.length) * 100}%`);
      }
    }
  }

  if (!customElements.get('ogee-product-media')) {
    customElements.define('ogee-product-media', OgeeProductMedia);
  }

  document.addEventListener('change', (event) => {
    const input = event.target.closest('.ogee-product-buy__option input[type="radio"]');

    if (!input) return;

    const fieldset = input.closest('.ogee-product-buy__option');
    const selectedValue = fieldset.querySelector('[data-ogee-selected-value]');
    const summaryLabel = fieldset.querySelector('[data-ogee-shade-summary-label]');
    const summarySwatch = fieldset.querySelector('[data-ogee-shade-summary-swatch]');
    const optionLabel = input.closest('.ogee-product-buy__option-label');
    const swatch = optionLabel ? optionLabel.querySelector('.swatch') : null;

    if (selectedValue) {
      selectedValue.textContent = input.value;
    }

    if (summaryLabel) {
      summaryLabel.textContent = input.value;
    }

    if (summarySwatch && swatch) {
      summarySwatch.innerHTML = swatch.outerHTML;
    }

    const gallery = input.closest('.ogee-product-buy')?.querySelector('ogee-product-media');

    if (!gallery) return;

    if (input.dataset.ogeeVariantId && gallery.selectVariantId(input.dataset.ogeeVariantId)) {
      return;
    }

    if (input.dataset.ogeeVariantMediaId) {
      gallery.selectMediaId(input.dataset.ogeeVariantMediaId);
    }
  });

  document.addEventListener('click', (event) => {
    const tab = event.target.closest('.ogee-product-buy__shade-tabs button');

    if (!tab) return;

    tab.parentElement.querySelectorAll('button').forEach((button) => {
      const active = button === tab;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
  });
{% endjavascript %}

