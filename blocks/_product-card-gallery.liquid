{% liquid
  assign product = closest.product
  assign is_clp_collection_card = false
  if template.name == 'collection'
    assign is_clp_collection_card = true
  endif

  assign clp_primary_badge = blank
  assign clp_secondary_badge = blank
  if is_clp_collection_card and product != blank
    assign clp_primary_badge = product.metafields.custom.card_badge.value | default: product.metafields.custom.badge_label.value
    assign clp_secondary_badge = product.metafields.custom.card_badge_secondary.value | default: product.metafields.custom.secondary_badge_label.value
    assign product_tags = product.tags | join: '|' | downcase

    if clp_primary_badge == blank
      if product.available == false
        assign clp_primary_badge = 'content.product_badge_sold_out' | t
      elsif product_tags contains 'best-seller'
        assign clp_primary_badge = 'Best-seller'
      elsif product_tags contains 'best seller'
        assign clp_primary_badge = 'Best-seller'
      elsif product_tags contains 'bestseller'
        assign clp_primary_badge = 'Best-seller'
      endif
    endif

    if clp_secondary_badge == blank
      if product_tags contains 'new shade'
        assign clp_secondary_badge = 'New shade'
      elsif product_tags contains 'new-shade'
        assign clp_secondary_badge = 'New shade'
      endif
    endif
  endif
%}

{% capture children %}
  {% unless product == blank %}
    {% if is_clp_collection_card %}
      {% if clp_primary_badge != blank or clp_secondary_badge != blank %}
        <div class="product-card__clp-badges">
          {% if clp_primary_badge != blank %}
            <span class="product-card__clp-badge">{{ clp_primary_badge | escape }}</span>
          {% endif %}
          {% if clp_secondary_badge != blank %}
            <span class="product-card__clp-badge">{{ clp_secondary_badge | escape }}</span>
          {% endif %}
        </div>
      {% endif %}
      <button
        type="button"
        class="product-card__clp-wishlist"
        aria-label="{{ 'actions.save_product' | t: product: product.title | escape }}"
      >
        <svg viewBox="0 0 20 20" focusable="false" aria-hidden="true">
          {% render 'icon', icon: 'heart' %}
        </svg>
      </button>
    {% else %}
      <div
        class="product-badges product-badges--{{ settings.badge_position }}"
        style="
          --badge-border-radius: {{ settings.badge_corner_radius }}px;
          --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};
        "
      >
        {%- if product.available == false or product.compare_at_price > product.price -%}
          <div
            class="
              product-badges__badge product-badges__badge--rectangle
              {% if product.available == false %} color-{{ settings.badge_sold_out_color_scheme }}{% elsif product.compare_at_price > product.price %} color-{{ settings.badge_sale_color_scheme }}{% endif %}
            "
          >
            {%- if product.available == false -%}
              {{ 'content.product_badge_sold_out' | t }}
            {%- elsif product.compare_at_price > product.price -%}
              {{ 'content.product_badge_sale' | t }}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {% endif %}
    {% if settings.quick_add or settings.mobile_quick_add %}
      {% if is_clp_collection_card %}
        {% liquid
          assign clp_add_to_cart_text = 'actions.add_to_cart' | t
          assign clp_choose_options_text = 'actions.select_shade' | t
        %}
        {% render 'quick-add',
          product: product,
          section_id: section.id,
          quick_add_class: 'quick-add--clp-gallery',
          quick_add_surface: 'quick-shop-drawer',
          add_to_cart_text: clp_add_to_cart_text,
          choose_options_text: clp_choose_options_text,
          icon_only_on_mobile: false
        %}
      {% else %}
        {% render 'quick-add', product: product, section_id: section.id %}
      {% endif %}
    {% endif %}
  {% endunless %}
{% endcapture %}

{% render 'card-gallery', children: children %}

{% # Title and price for the zoomed out grid view %}
<div class="product-grid-view-zoom-out--details">
  {% if product == blank %}
    <h3 class="h4">{{ 'content.product_card_placeholder' | t }}</h3>
  {% else %}
    <h3 class="h4">{{ product.title }}</h3>
  {% endif %}
</div>

{% render 'product-badges-styles' %}

{% schema %}
{
  "name": "t:names.product_image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "portrait",
      "label": "t:settings.aspect_ratio",
      "info": "t:info.aspect_ratio_adjusted"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_card_media",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
