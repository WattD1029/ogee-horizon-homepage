{% javascript %}
  if (!customElements.get('clp-floating-controls')) {
    class ClpFloatingControls extends HTMLElement {
      connectedCallback() {
        if (!this.hasAttribute('data-clp-floating-controls')) return;
        if (this.isInitialized) return;

        this.isInitialized = true;
        this.navs = this.querySelectorAll('[data-clp-floating-nav]');
        this.boundUpdate = this.updateFloatingState.bind(this);
        this.boundResize = this.handleResize.bind(this);

        this.copyNavigationLinks();

        requestAnimationFrame(() => {
          this.anchorScrollY = this.getBoundingClientRect().top + window.scrollY;
          this.updateFloatingState();
        });

        window.addEventListener('scroll', this.boundUpdate, { passive: true });
        window.addEventListener('resize', this.boundResize);
      }

      disconnectedCallback() {
        if (!this.isInitialized) return;

        window.removeEventListener('scroll', this.boundUpdate);
        window.removeEventListener('resize', this.boundResize);

        this.isInitialized = false;
      }

      copyNavigationLinks() {
        const sourceNavigation = document.querySelector('[data-clp-subcollection-list]');

        if (!this.navs.length || !sourceNavigation) return;

        const sourceLinks = sourceNavigation.querySelectorAll('a.clp-intro__subcollection-link');

        this.navs.forEach((nav) => {
          const fragment = document.createDocumentFragment();
          const labelSelector =
            nav.dataset.clpFloatingNav === 'mobile'
              ? '.clp-intro__subcollection-label--mobile'
              : '.clp-intro__subcollection-label--desktop';

          sourceLinks.forEach((sourceLink) => {
            const sourceLabel =
              sourceLink.querySelector(labelSelector) ||
              sourceLink.querySelector('.clp-intro__subcollection-label--desktop') ||
              sourceLink;
            const label = sourceLabel.textContent.trim();

            if (!label) return;

            if (nav.dataset.clpFloatingNav === 'mobile') {
              const normalizedLabel = label.toLowerCase().replace(/\s+/g, ' ');

              if (
                normalizedLabel === 'all' ||
                normalizedLabel === 'all products' ||
                normalizedLabel === 'bestseller' ||
                normalizedLabel === 'bestsellers' ||
                normalizedLabel === 'new'
              ) {
                return;
              }
            }

            const floatingLink = document.createElement('a');
            const sourceImage = sourceLink.querySelector('.clp-intro__subcollection-image img');

            floatingLink.className = 'facets-clp-floating-nav__link';
            floatingLink.href = sourceLink.href;

            if (nav.dataset.clpFloatingNav === 'mobile' && sourceImage) {
              const imageWrapper = document.createElement('span');
              const image = sourceImage.cloneNode(false);

              floatingLink.classList.add('facets-clp-floating-nav__link--has-image');
              imageWrapper.className = 'facets-clp-floating-nav__image';
              imageWrapper.setAttribute('aria-hidden', 'true');
              image.alt = '';
              imageWrapper.append(image);
              floatingLink.append(imageWrapper);
            }

            const labelWrapper = document.createElement('span');

            labelWrapper.textContent = label;
            floatingLink.append(labelWrapper);

            if (sourceLink.getAttribute('aria-current') === 'page') {
              floatingLink.setAttribute('aria-current', 'page');
            }

            fragment.append(floatingLink);
          });

          nav.replaceChildren(fragment);
        });
      }

      handleResize() {
        this.copyNavigationLinks();

        if (!this.classList.contains('facets-block-wrapper--clp-floating')) {
          this.anchorScrollY = this.getBoundingClientRect().top + window.scrollY;
        }

        this.updateFloatingState();
      }

      updateFloatingState() {
        const topOffset = Number.parseFloat(
          getComputedStyle(this).getPropertyValue('--clp-floating-controls-top')
        ) || 0;
        const shouldFloat = typeof this.anchorScrollY === 'number' && window.scrollY > this.anchorScrollY - topOffset;

        this.classList.toggle('facets-block-wrapper--clp-floating', shouldFloat);
      }
    }

    customElements.define('clp-floating-controls', ClpFloatingControls);
  }
{% endjavascript %}

