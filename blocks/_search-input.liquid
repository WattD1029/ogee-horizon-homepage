{%- assign block_settings = block.settings -%}
{% liquid
  assign active_type = search.types | first | default: 'product'
  if active_type == 'article'
    assign active_type = 'article'
  elsif active_type == 'page'
    assign active_type = 'page'
  else
    assign active_type = 'product'
  endif
%}

<script
  src="{{ 'search-page-input.js' | asset_url }}"
  defer
  type="module"
></script>

{% if block_settings.inherit_color_scheme == false %}
  {% assign color_scheme = block_settings.color_scheme | prepend: ' color-' %}
{% endif %}

<form action="{{ routes.search_url }}" method="get" role="search" class="search-page-input__parent">
  <search-page-input-component
    class="search-page-input-component--ogee"
    style="{% render 'size-style', settings: block_settings %}{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    <label for="SearchPageInput--{{ block.id }}" class="visually-hidden">
      {{ 'content.search_input_label' | t }}
    </label>
    <span class="svg-wrapper search__icon{{ color_scheme }}">
      {{ 'icon-search.svg' | inline_asset_content }}
    </span>
    <input name="type" value="{{ active_type }}" type="hidden">
    <input
      class="search-page-input{{ color_scheme }}"
      id="SearchPageInput--{{ block.id }}"
      type="search"
      name="q"
      ref="searchPageInput"
      on:keydown="/handleKeyDown"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'content.search_input_placeholder' | t }}"
    >
    <a
      href="{{ routes.search_url }}?type={{ active_type }}&q="
      class="search__reset-button{{ color_scheme }}"
      aria-label="{{ 'accessibility.reset_search' | t }}"
    >
      <span class="svg-wrapper search__reset-button-icon">
        {{ 'icon-reset.svg' | inline_asset_content }}
      </span>
      <span class="search__reset-button-text">{{ 'actions.clear' | t }}</span>
    </a>
  </search-page-input-component>

  {% if active_type == 'product' and search.results.size == 0 and search.terms != blank %}
    <div class="search-results__no-results">
      <p>{{ 'content.search_results_no_results_check_spelling' | t: terms: search.terms }}</p>
    </div>
  {% endif %}
</form>

{% stylesheet %}
  .search-page-input__parent {
    display: flex;
    flex-direction: column;
    align-items: var(--horizontal-alignment);
    width: 100%;
  }

  .search-results__no-results {
    opacity: var(--opacity-subdued-text);
  }

  search-page-input-component {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    background-color: var(--color-background);
  }

  .search-page-input-component--ogee {
    max-width: 600px;
    margin: 0;
    border-bottom: 1px solid var(--color-border);
  }

  .search-page-input {
    width: 100%;
    min-height: 54px;
    color: var(--color-input-text);
    background: transparent;
    padding: 12px 48px;
    text-overflow: ellipsis;
    overflow: hidden;
    border: 0;
    border-radius: 0;
    outline: 0;
  }

  .search-page-input::placeholder {
    color: rgb(var(--color-input-text-rgb) / var(--opacity-subdued-text));
  }

  search-page-input-component .search__icon,
  search-page-input-component .search__reset-button {
    position: absolute;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    background: transparent;
  }

  search-page-input-component .search__icon {
    left: 0;
    pointer-events: none;
  }

  search-page-input-component .search__reset-button {
    right: 0;
    border-radius: 50%;
    color: var(--color-input-text);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  search-page-input-component .search__icon svg,
  search-page-input-component .search__reset-button svg {
    width: 18px;
    height: 18px;
  }

  search-page-input-component:has(.search-page-input:not(:placeholder-shown)) .search__reset-button {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  search-page-input-component .search__reset-button-text {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .search-page-input-component--ogee {
      max-width: 100%;
    }

    .search-page-input {
      min-height: 48px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.search_input",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        { "value": "fill", "label": "t:options.fill" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ block.settings.width == \"custom\" }}"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    }
  ],
  "presets": []
}
{% endschema %}
