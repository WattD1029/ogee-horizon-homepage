{% doc %}
  Renders a short product subtitle for product cards.

  @param {product} closest.product - Product to render the subtitle for.
{% enddoc %}

{% liquid
  assign product = closest.product
  assign block_settings = block.settings
  assign subtitle = blank

  case block_settings.source
    when 'type'
      assign subtitle = product.type
    when 'vendor'
      assign subtitle = product.vendor
    else
      assign subtitle = product.metafields.custom.subtitle.value

      if subtitle == blank
        assign subtitle = product.metafields.custom.short_description.value
      endif

      if subtitle == blank
        assign subtitle = product.metafields.descriptors.subtitle.value
      endif

      if subtitle == blank
        assign subtitle = product.type
      endif
  endcase

  if subtitle == blank
    if block_settings.use_vendor_fallback
      assign subtitle = product.vendor
    endif
  endif
%}

{% if subtitle != blank %}
  <p
    class="product-card__subtitle spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    {{ subtitle | strip_html | escape }}
  </p>
{% endif %}

{% schema %}
{
  "name": "t:names.product_subtitle",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_subtitle"
    },
    {
      "type": "select",
      "id": "source",
      "label": "t:settings.subtitle_source",
      "options": [
        {
          "value": "metafield",
          "label": "t:options.metafield"
        },
        {
          "value": "type",
          "label": "t:options.product_type"
        },
        {
          "value": "vendor",
          "label": "t:options.vendor"
        }
      ],
      "default": "metafield"
    },
    {
      "type": "checkbox",
      "id": "use_vendor_fallback",
      "label": "t:settings.use_vendor_fallback",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_subtitle",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
